# Root .env — loaded by python-dotenv for FastAPI, scrapers, schedulers,
# IB Gateway, and the watchdog. Copy to .env and fill in values.
#
#   cp .env.example .env
#
# Mirrors the production layout on the Hetzner VPS at
# /home/radon/radon-cloud/.env. Marked vars are required for production;
# optional vars degrade gracefully when unset.
#
# IMPORTANT: values containing `$` MUST be single-quoted. Bash loaders
# (`set -a; . file; set +a`) shell-expand `$VAR` substrings and under
# `set -u` an unset reference aborts silently from systemd. Single-quote
# the value (`PASS='RX$abc!xyz'`) or use a non-shell loader (systemd
# EnvironmentFile=, python-dotenv). See feedback_env_file_shell_expansion.md.

# =============================================================================
# Mode / deployment (required)
# =============================================================================
# `local`  — laptop-resident schedulers (launchd)
# `hetzner` — Hetzner-resident schedulers (systemd)
RADON_MODE=local
# Hostname Caddy serves. `localhost` for dev, `app.radon.run` on Hetzner.
DOMAIN=localhost
# Internal API base used by Next.js → FastAPI server-to-server. Auth
# bypass for localhost/::1 is wired into FastAPI; production points at
# the Tailscale-side hostname.
RADON_API_URL=http://localhost:8321
NEXT_PUBLIC_RADON_API_URL=http://localhost:8321
# WS relay (`ib_realtime_server.js`) URL exposed to the browser.
NEXT_PUBLIC_IB_REALTIME_WS_URL=ws://localhost:8765
# Standard Node knobs (Next.js process).
NODE_ENV=development
PORT=3000

# =============================================================================
# IB Gateway connection (required)
# =============================================================================
# `docker` (default) | `cloud` (remote, no restart) | `launchd` (legacy)
IB_GATEWAY_MODE=docker
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4001
# Hetzner-only: compose project dir for the radon-cloud-owned IB Gateway
# container (`radon-ib-gateway.service` launches docker compose from here,
# NOT the in-tree docker/ib-gateway/). Required on Hetzner; leave unset
# on laptop.
# IB_GATEWAY_COMPOSE_DIR=/home/radon/radon-cloud

# =============================================================================
# IB Gateway login (required when running the Docker container)
# =============================================================================
# Consumed by ghcr.io/gnzsnz/ib-gateway via docker/ib-gateway/.env on
# laptop. Trading mode + read-only flag are passed straight through to
# IB Gateway. `live` is the only mode wired up; `paper` is untested.
TWS_USERID=your_ib_username
TWS_PASSWORD=xxxxxxxxxxxxxxxxxx
TRADING_MODE=live
READ_ONLY_API=no
TWS_ACCEPT_INCOMING=accept
# VNC password for the IB Gateway container — needed only when 2FA push
# fails and you have to click the prompt by hand. Pair with a
# docker-compose.override.yml to expose port 5900.
VNC_SERVER_PASSWORD=xxxxxxxx
# `manual` | `secondary` — controls behaviour when IB detects an
# existing session. `manual` blocks the new login (operator must approve
# in the desktop client); `secondary` auto-takes over.
EXISTING_SESSION_DETECTED_ACTION=manual

# =============================================================================
# IB Flex (query ids required; Web Service token is recon-only)
# =============================================================================
# Routine cash / TWR / journal recon: IBKR sFTP. See docs/flex-sftp-setup.md.
# IB_FLEX_TOKEN is NOT used by radon-flex-pull. Keep it for --sendrequest recon
# after flex_embargo.is_blocked() is false. Do not weekday SendRequest.
IB_FLEX_TOKEN=xxxxxxxxxxxxxxxxxxxx
# Trade blotter Flex query ID (canonical).
IB_FLEX_QUERY_ID=1422766
# Activity Flex query "Equity Summary in Base". DO NOT repurpose for trade pulls.
# Carries THREE sections and every one of them is load-bearing:
#   NAV in Base       -> the TWR NAV series (perf_twr_builder)
#   Cash Transactions -> deposits/withdrawals (cash_flow_sync, and half the flow map)
#   Transfers         -> ACATS / securities transfers (the other half of the flow map)
# Dropping a section silently degrades /performance; without Transfers an ACATS is
# invisible and the TWR refuses to publish.
IB_FLEX_NAV_QUERY_ID=1442520

# Leave UNSET. perf_twr_builder falls back to IB_FLEX_NAV_QUERY_ID and reuses the
# single fetched statement, so a run makes ONE Flex request. Pointing this at a
# second query id doubles the request rate against a token that has already taken
# a 24h-to-168h IBKR throttle embargo.
# IB_FLEX_FLOWS_QUERY_ID=

# =============================================================================
# Turso (required — source of truth for journal, service_health, etc)
# =============================================================================
# Embedded-replica syncs to data/replica.db. Only one long-running
# process per host can hold replica.db open; second writer crashes with
# WalConflict — set RADON_DB_NO_REPLICA=1 in scrapers/schedulers.
TURSO_DB_URL=libsql://radon-<workspace>.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Isolated demo Turso — the trial surface's own database, never production.
# radon-demo-mirror.service runs `scripts/db/migrate.py --demo` as an
# ExecStartPre; resolve_target() exits 2 when either is unset, so the unit
# fails on every fire without them. The URL must carry the `radon-demo`
# marker and must NOT carry the production one.
TURSO_DEMO_DB_URL=libsql://radon-demo-<workspace>.turso.io
TURSO_DEMO_AUTH_TOKEN=eyJ...

# =============================================================================
# Portfolio cold-archive — Backblaze B2 (REQUIRED on production VPS)
# =============================================================================
# scripts/archive_portfolio_snapshots.py (radon-portfolio-archive.service) keeps
# ~30d of portfolio_snapshots in Turso and uploads older months to B2 before
# DELETE. Production unit FAILS CLOSED without these vars (no
# --allow-delete-without-upload). boto3 talks S3 API to B2; Cloudflare R2 is
# NOT used (billing lock / enablement blocked as of 2026-07).
#
# Provider: Backblaze B2 — https://secure.backblaze.com
# Bucket:   radon-archive (private)
# Live:     VPS EnvironmentFile=/home/radon/radon-cloud/.env
#
# Setup:
#   1. Buckets → Create Bucket → name radon-archive, Private
#   2. Application Keys → Add a New Application Key
#      allow listBuckets, readFiles, writeFiles, deleteFiles on radon-archive
#   3. Copy Endpoint from bucket details (must include https://)
#   4. keyID → ACCESS_KEY_ID ; applicationKey → SECRET_ACCESS_KEY
#
# Example (us-west-004):
RADON_ARCHIVE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
RADON_ARCHIVE_S3_BUCKET=radon-archive
RADON_ARCHIVE_S3_ACCESS_KEY_ID=
RADON_ARCHIVE_S3_SECRET_ACCESS_KEY=
RADON_ARCHIVE_S3_REGION=us-west-004
RADON_ARCHIVE_S3_PREFIX=portfolio_snapshots/
# Optional local monthly partition dir (default on VPS):
# RADON_ARCHIVE_DIR=/home/radon/radon-cloud/archive/portfolio_snapshots

# =============================================================================
# Media volume backup — Backblaze B2 (media.radon.run tree)
# =============================================================================
# cloud/scripts/media_backup.py (radon-media-backup.service) mirrors
# /home/radon/radon-cloud/media to the same radon-archive bucket under
# prefix media/. Reuses RADON_ARCHIVE_S3_* by default (fail-closed if
# unset). Optional overrides for a dedicated application key / bucket:
#
# RADON_MEDIA_DIR=/home/radon/radon-cloud/media
# RADON_MEDIA_BACKUP_PREFIX=media/
# RADON_MEDIA_BACKUP_S3_ENDPOINT=
# RADON_MEDIA_BACKUP_S3_BUCKET=
# RADON_MEDIA_BACKUP_S3_ACCESS_KEY_ID=
# RADON_MEDIA_BACKUP_S3_SECRET_ACCESS_KEY=
# RADON_MEDIA_BACKUP_S3_REGION=

# =============================================================================
# Clerk authentication (required in production; bypassed on localhost)
# =============================================================================
# JWT verification side (FastAPI):
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Comma-separated list of Clerk user IDs allowed into the terminal.
ALLOWED_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxx
# Next.js side:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# =============================================================================
# Health daemon /status detail token (optional)
# =============================================================================
# Caddy reverse_proxies app.radon.run/edge-health/status to the isolated health
# daemon with no auth of its own, so the daemon trust-splits the body: a request
# carrying proxy headers gets the aggregate verdict only (no unit inventory, no
# service_health error text, no broker auth_state). An on-box caller with no
# proxy headers keeps the full body, which covers the watchdogs, the deploy
# health-gate and the Next.js admin proxy (it reads 127.0.0.1:8330 directly).
# Set this shared bearer only when a consumer must obtain detail THROUGH the
# public edge; leave it unset and the edge simply stays redacted. Read by both
# scripts/health_service/serve.py and web/app/api/admin/edge-health/route.ts,
# which both load /home/radon/radon-cloud/.env in production. Never expose it as
# a NEXT_PUBLIC_ variable — that ships the token to every browser.
RADON_HEALTH_STATUS_TOKEN=

# =============================================================================
# Unusual Whales (required for scanner/discover/options-flow/dark-pool)
# =============================================================================
UW_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AI / LLM providers
# =============================================================================
# Required for vision tagger, seasonality fallback, assistant chat,
# share-card OG renders.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Used by the newsfeed text tagger (gpt-oss-120b → qwen-3 fallback). The
# router falls back to Anthropic when this is unset; tagging is skipped
# entirely if both providers are missing.
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Presence of a key is what makes that provider selectable in the
# chat model picker; absence is a supported state, not a misconfiguration.
# Deliberately NOT in cloud/config/required-env.txt — the deploy preflight
# fails closed on a missing required key.
# XAI_API_KEY=            # alias: GROK_API_KEY. xAI Inference API (console.x.ai)
# OPENAI_API_KEY=
# Operator pins for radon-model-catalog.timer — each wins over discovery.
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# XAI_MODEL=              # alias: GROK_MODEL

# =============================================================================
# Artificial Analysis (LLM Token Expenditure Index)
# =============================================================================
# Required only if you run scripts/llm_token_index.py / radon-llm-index.timer.
# Free tier: 1000 requests/day. Sign up at https://artificialanalysis.ai/login
# then generate a key in the Insights dashboard. Without this set the daily
# timer logs an error and skips the write — UI shows "no data yet" until the
# key is provided and the timer fires.
ARTIFICIAL_ANALYSIS_API_KEY=aa_xxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Newsfeed scraper (themarketear.com) — required if running scripts/newsfeed/
# =============================================================================
# Headless Playwright login. Storage cached at data/newsfeed-storage.json
# (~30d), full re-auth every ~6h.
THEMARKETEAR_EMAIL=your_account@example.com
THEMARKETEAR_PASSWORD=xxxxxxxxxxxxxxxxxx
# RADON_NEWSFEED_HEADLESS=1   # set 0 to launch a visible browser for debugging

# =============================================================================
# MenthorQ CTA (required for /menthorq/* surfaces)
# =============================================================================
MENTHORQ_USER=your_account@example.com
MENTHORQ_PASS=xxxxxxxxxxxxxxxxxx
# dashboard.menthorq.io redirects through the WordPress login above to establish
# its Cognito/NextAuth session. Radon automatically saves a dedicated state.
# These optional settings support an explicit state location or short-term override.
# MENTHORQ_DASHBOARD_STORAGE_STATE=/absolute/path/to/menthorq_dashboard_storage_state.json
# MENTHORQ_DASHBOARD_ACCESS_TOKEN=
# MarketDataWorks API key — feeds CTA enrichment.
MDW_API_KEY=xxxxxxxxxxxxxxxxxx

# =============================================================================
# Media host (Hetzner only)
# =============================================================================
# Where the laptop rsyncs newsfeed images to. On the VPS itself this is
# a local fs path (rsync skips SSH self-loop).
# Laptop default: <user>@<prod-host>:/path/to/media/
# Hetzner default: /path/to/media/
# RADON_MEDIA_REMOTE=<user>@<prod-host>:/path/to/media/

# =============================================================================
# Watchdog alert routing (optional — absent vars degrade gracefully)
# =============================================================================
# Pushover is the only external channel. P1 alerts cut through iOS DnD
# and enqueue a laptop Grok ticket (docs/grok-page-responder.md).
# Live-deploy and Grok follow-ups are normal priority (never P1).
# P2/P3 land in the service_health table only. When unset, the watchdog
# prints a one-line startup warning and writes alerts to service_health.
# PUSHOVER_USER=u123abc...
# PUSHOVER_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROK_PAGE_RESPONDER=0    # laptop poller off
# GROK_PAGE_AUTOSHIP=0     # diagnose only
# GROK_PAGE_AUTOPUSH=0     # commit, do not push

# =============================================================================
# Equibles (off-exchange volume, short crowding, 13F, CFTC COT, filing forensics)
# =============================================================================
# Bearer key for https://api.equibles.com/v1, read by scripts/clients/equibles_client.py.
# Pro plan allowance is 100,000 requests/day shared across REST and MCP, resetting
# 00:00 UTC — every paginated page is billed separately, so bound max_pages.
# REQUIRED IN PRODUCTION (cloud/config/required-env.txt): the five
# radon-equibles-*.timer oneshots construct EquiblesClient(), which raises
# EquiblesAuthError when this is unset, killing the unit before it can write a
# service_health row.
# EQUIBLES_API_KEY=eq_live_xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Robinhood (READ-ONLY quote/historicals failover + retail-crowding overlay)
# =============================================================================
# Official trading MCP only (OAuth 2.1 + PKCE, Streamable HTTP), read by
# scripts/clients/robinhood_client.py. Rank: below IB, UW and the official
# Cboe feeds; ABOVE Yahoo (IB > UW > Cboe > Robinhood > Yahoo).
# READ-ONLY: Radon never calls a place_*/cancel_* tool — execution stays on
# IB. No dark pool, OTC, sweeps, GEX, or vol surface. Option surface probed
# live (2026-08-30 dump, 67 tools): get_option_quotes takes instrument_ids
# (UUIDs), returns real-time quotes + official prior-session close, no
# greeks/IV/OI — NBBO/last + prior-close failover only, never a vol surface.
#
# ⚠️ Access tokens from https://api.robinhood.com/oauth2/token/ expire in
# ~3 days, so REFRESH IS MANDATORY in production. Tokens persist in a 0600
# JSON file the process rewrites atomically on every refresh
# (access_token, refresh_token, client_id, token_type, expires_at/written_at).
# NEVER commit that file (default data/rh_mcp_token.json is gitignored;
# VPS: /etc/radon/rh-mcp.json). Env vars below only BOOTSTRAP the file on
# first configured run. Refresh: grant_type=refresh_token + client_id,
# form-encoded, public client — no secret. Discovery:
# https://agent.robinhood.com/.well-known/oauth-authorization-server/mcp/trading
#
# OPTIONAL everywhere: with no access token and no refresh credentials every
# ladder skips Robinhood cleanly (no network, no error) and falls through to
# Yahoo. A rejected refresh grant (invalid_grant) degrades the process to
# that same skip instead of crashing ladders.
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# ROBINHOOD_MCP_TOKEN_FILE=/etc/radon/rh-mcp.json
# ROBINHOOD_MCP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# ROBINHOOD_MCP_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# ROBINHOOD_MCP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
