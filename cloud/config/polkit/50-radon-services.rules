// The watchdog may invoke only its fixed preheld adapter, which consumes its
// exact 2FA lease once. Every other mutation uses the root-owned operator.
// Any unit where unit.indexOf("radon-ib-gateway") != 0 is non-gateway and is
// not granted here. Gateway units other than the preheld adapter are denied.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "radon") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (!unit) {
            return polkit.Result.NOTHING;
        }
        if (unit.indexOf("radon-ib-gateway") != 0) {
            return polkit.Result.NOTHING;
        }
        if (unit == "radon-ib-gateway-preheld-restart.service" &&
            (verb == "start" || verb == "restart")) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});

// The grok page responder may reset-failed + start exactly these benign
// timer-owned data-fetch oneshots when a deploy / `radon restart` SIGTERM'd
// them mid-run, or when they exited non-zero and a fix has deployed since,
// and the next timer slot is more than 12h away. No stop, no restart, no
// other units. Keep in sync with RERUNNABLE_ONESHOT_UNITS in
// scripts/grok_page_responder.py (pinned by
// test_allowlist_matches_the_polkit_grant).
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        subject.user != "radon") {
        return polkit.Result.NOTHING;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var rerunnable = {
        "radon-vol-cone.service": true,
        "radon-skew.service": true,
        "radon-skew2d.service": true,
        "radon-bpi.service": true,
        "radon-leap.service": true,
        "radon-garch.service": true,
        "radon-cor.service": true,
        "radon-vixcor.service": true,
        "radon-straddle.service": true,
        "radon-credit-spread.service": true,
        "radon-ivrank.service": true,
        "radon-yield-curve.service": true,
        "radon-margin-debt.service": true,
        "radon-forecast-nightly.service": true,
        "radon-catalysts.service": true,
        "radon-cta-sync.service": true,
        "radon-oi-changes.service": true,
        "radon-perf-twr.service": true,
        "radon-llm-index.service": true,
        "radon-equibles-filings.service": true,
        "radon-equibles-short-crowding.service": true,
        "radon-equibles-13f.service": true,
        "radon-equibles-ats.service": true,
        "radon-equibles-cot.service": true
    };
    if (unit && rerunnable[unit] === true &&
        (verb == "start" || verb == "reset-failed")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOTHING;
});
