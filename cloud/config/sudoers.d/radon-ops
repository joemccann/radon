# /etc/sudoers.d/radon-ops
# Allows the radon user to invoke the root-owned, argument-validating operator.
# No direct service mutation capability is granted here.
#
# Install:  sudo visudo -c -f /tmp/radon-ops-sudoers && sudo cp /tmp/radon-ops-sudoers /etc/sudoers.d/radon-ops && sudo chmod 0440 /etc/sudoers.d/radon-ops
# Verify:   sudo -l -U radon | grep -A20 'NOPASSWD'

# --- authoritative stack and single-unit operator paths ---
radon ALL=(root) NOPASSWD: /usr/local/bin/radon start, /usr/local/bin/radon stop, /usr/local/bin/radon restart
radon ALL=(root) NOPASSWD: /usr/local/bin/radon unit start radon-*.service, /usr/local/bin/radon unit stop radon-*.service, /usr/local/bin/radon unit restart radon-*.service
radon ALL=(root) NOPASSWD: /usr/local/bin/radon unit start radon-*.timer, /usr/local/bin/radon unit stop radon-*.timer, /usr/local/bin/radon unit restart radon-*.timer

# Host lifecycle remains explicit operator-only maintenance. No reboot or shutdown grant.

# --- faillock self-recovery (cannot lock yourself out forever) ---
radon ALL=(root) NOPASSWD: /usr/sbin/faillock --user radon --reset
radon ALL=(root) NOPASSWD: /usr/sbin/faillock --user radon

# --- read-only diagnostic helpers ---
# No journalctl grant: a wildcard unit argument would admit every journalctl
# option as root. Unit logs go through `radon logs radon-NAME.service`
# instead: the root-owned operator validates argc (exactly one unit) and the
# ^radon-[a-z0-9-]+\.service$ regex, refuses radon-beta-*, then builds a fixed
# journalctl argv (-u <unit> -n 300 -o json, MESSAGE and PRIORITY only). The
# caller supplies no journalctl option. Feeds the /admin log disclosure.
radon ALL=(root) NOPASSWD: /usr/local/bin/radon logs radon-*.service
radon ALL=(root) NOPASSWD: /usr/bin/docker logs ib-gateway

# --- Gateway container control (replaces radon's group `docker` membership) ---
# Group docker is root-equivalent; radon held it only to drive ONE container.
# radon-docker-gw is root-owned and takes a fixed verb set against a pinned
# container, with no caller-supplied paths, images, mounts or flags. Each verb
# is listed in full: a trailing wildcard would hand back the arbitrary argv the
# shim exists to refuse.
radon ALL=(root) NOPASSWD: /usr/local/sbin/radon-docker-gw compose-up, /usr/local/sbin/radon-docker-gw compose-down, /usr/local/sbin/radon-docker-gw inspect-running, /usr/local/sbin/radon-docker-gw config-check
radon ALL=(root) NOPASSWD: /usr/local/sbin/radon-docker-gw pgrep-jvm, /usr/local/sbin/radon-docker-gw pgrep-java, /usr/local/sbin/radon-docker-gw thread-dump [0-9]*
radon ALL=(root) NOPASSWD: /usr/local/sbin/radon-docker-gw logs, /usr/local/sbin/radon-docker-gw stats, /usr/local/sbin/radon-docker-gw ps

# --- IB Gateway password rotation (broker) ---
# The broker daemon (scripts/ib_gateway_remote/serve.py, POST /rotate-password)
# writes the new password into /etc/radon/ib-gateway/gateway.env through this
# root-owned writer. The password travels on stdin only, never in argv. Exactly
# one verb: migrate, prune-root-env and rollback stay root-only. Do not add a
# log_input Default for radon: it would record that stdin.
radon ALL=(root) NOPASSWD: /usr/local/sbin/radon-ib-gateway-credential write

# Anything else still requires the password; no blanket NOPASSWD or direct
# systemctl/docker mutator is authorized.
