# /etc/sudoers.d/radon-beta
# Install as root:  sudo install -m 0440 sudoers.radon-beta.example /etc/sudoers.d/radon-beta
# Validate BEFORE relying on it:  sudo visudo -cf /etc/sudoers.d/radon-beta
#
# Command-scoped NOPASSWD mirroring the existing /etc/sudoers.d/radon-deploy
# pattern (which we could not read as the radon user — confirm with
# `sudo cat /etc/sudoers.d/radon-deploy` and match its exact style/paths).
# deploy-beta.sh calls only `sudo systemctl restart <the three beta units>`,
# so that is the only privilege beta strictly needs. start/stop added for
# operator convenience + the admin panel.
#
# IMPORTANT: sudoers matches argv EXACTLY. `systemctl restart a b c` is a
# DIFFERENT command string than three single-unit restarts. deploy-beta.sh
# issues ONE multi-unit restart, so the multi-unit line below must match it
# verbatim. If you change SERVICES order/content in deploy-beta.sh, update here.

radon ALL=(root) NOPASSWD: /usr/bin/systemctl restart radon-beta-nextjs.service radon-beta-api.service radon-beta-health.service

# Per-unit control (admin panel / manual ops):
radon ALL=(root) NOPASSWD: /usr/bin/systemctl start   radon-beta-nextjs.service, \
                           /usr/bin/systemctl stop    radon-beta-nextjs.service, \
                           /usr/bin/systemctl restart radon-beta-nextjs.service, \
                           /usr/bin/systemctl start   radon-beta-api.service, \
                           /usr/bin/systemctl stop    radon-beta-api.service, \
                           /usr/bin/systemctl restart radon-beta-api.service, \
                           /usr/bin/systemctl start   radon-beta-health.service, \
                           /usr/bin/systemctl stop    radon-beta-health.service, \
                           /usr/bin/systemctl restart radon-beta-health.service

# If the prod admin panel controls services via polkit (see project memory
# "admin_panel" — /etc/polkit-1/rules.d/50-radon-services.rules) rather than
# sudoers, extend THAT rule's unit glob to also match radon-beta-* instead of
# (or in addition to) the lines above. Read it first: sudo cat /etc/polkit-1/rules.d/50-radon-services.rules
