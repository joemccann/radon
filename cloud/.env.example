# =============================================================================
# Radon Cloud Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# IB Gateway
# -----------------------------------------------------------------------------
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002
IB_GATEWAY_MODE=cloud
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
TWS_ACCEPT_INCOMING=
READ_ONLY_API=no
VNC_SERVER_PASSWORD=
EXISTING_SESSION_DETECTED_ACTION=primary

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Note: Production Clerk uses clerk.<yourdomain> as the issuer/JWKS URL.
# Dev instances use <instance-name>.clerk.accounts.dev instead.
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# User Allowlist (comma-separated Clerk user IDs)
# -----------------------------------------------------------------------------
ALLOWED_USER_IDS=user_...
# Fail-closed interlock (REL-029/R-054): 1 = an empty/blanked allowlist
# rejects every principal instead of admitting any valid Clerk JWT.
RADON_REQUIRE_OPERATOR_ALLOWLIST=1

# -----------------------------------------------------------------------------
# API URLs
# -----------------------------------------------------------------------------
RADON_API_URL=http://127.0.0.1:8321
RADON_PROBE_FRESHNESS_TOKEN=
NEXT_PUBLIC_RADON_API_URL=https://app.radon.run/api/ib
NEXT_PUBLIC_IB_REALTIME_WS_URL=wss://app.radon.run/ws

# -----------------------------------------------------------------------------
# Domain (used by Caddyfile)
# -----------------------------------------------------------------------------
DOMAIN=app.radon.run

# -----------------------------------------------------------------------------
# External API Tokens
# -----------------------------------------------------------------------------
UW_TOKEN=
MDW_API_KEY=
TURSO_DB_URL=
TURSO_AUTH_TOKEN=
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
IB_FLEX_NAV_QUERY_ID=
# P1 = iPhone emergency + Turso watchdog_pages ticket.
# Live-deploy / Grok follow-up pages are priority 0. See docs/grok-page-responder.md
PUSHOVER_USER=
PUSHOVER_TOKEN=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=

# -----------------------------------------------------------------------------
# Portfolio cold-archive — Backblaze B2 (REQUIRED for radon-portfolio-archive)
# -----------------------------------------------------------------------------
# S3-compatible API (boto3). Cloudflare R2 is not used. See root .env.example.
# Unit: radon-portfolio-archive.service — fails closed if unset.
RADON_ARCHIVE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
RADON_ARCHIVE_S3_BUCKET=radon-archive
RADON_ARCHIVE_S3_ACCESS_KEY_ID=
RADON_ARCHIVE_S3_SECRET_ACCESS_KEY=
RADON_ARCHIVE_S3_REGION=us-west-004
RADON_ARCHIVE_S3_PREFIX=portfolio_snapshots/
# RADON_ARCHIVE_DIR=/home/radon/radon-cloud/archive/portfolio_snapshots

# -----------------------------------------------------------------------------
# Media volume backup — Backblaze B2 (radon-media-backup.timer)
# -----------------------------------------------------------------------------
# Mirrors Caddy media root to B2 prefix media/ (same bucket as portfolio
# archive by default). Unit fails closed without RADON_ARCHIVE_S3_* (or
# RADON_MEDIA_BACKUP_S3_*). Optional:
# RADON_MEDIA_DIR=/home/radon/radon-cloud/media
# RADON_MEDIA_BACKUP_PREFIX=media/
# RADON_MEDIA_BACKUP_S3_ENDPOINT=
# RADON_MEDIA_BACKUP_S3_BUCKET=
# RADON_MEDIA_BACKUP_S3_ACCESS_KEY_ID=
# RADON_MEDIA_BACKUP_S3_SECRET_ACCESS_KEY=
# RADON_MEDIA_BACKUP_S3_REGION=

# -----------------------------------------------------------------------------
# Scrapers and Media
# -----------------------------------------------------------------------------
THEMARKETEAR_EMAIL=
THEMARKETEAR_PASSWORD=
MENTHORQ_USER=
MENTHORQ_PASS=
RADON_MEDIA_REMOTE=

# -----------------------------------------------------------------------------
# Runtime Mode
# -----------------------------------------------------------------------------
RADON_MODE=cloud

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
