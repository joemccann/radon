[Unit]
Description=Radon market calendar refresh (IBKR SPY liquidHours, weekly)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
# Same script POST /market-calendar/refresh runs. It merges IBKR's ~6-day
# liquidHours window into data/market_calendar.json, the cache the relay
# and market_state() read. Heartbeat `market-calendar` (8-day window) on
# every run; a failed run also exits 1 so the unit watchdog sees it.
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_market_calendar.py
StandardOutput=journal
StandardError=journal
# Four clientId connect attempts at 8s plus one contractDetails call.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
