[Unit]
Description=Radon config drift audit (live system vs monorepo cloud source)
Wants=network-online.target
After=network-online.target
# DUR-06 (2026-06-12): diffs live config (Caddyfile, compose, systemd units +
# drop-ins, polkit, sudoers, /usr/local/bin/radon) against the repo copies and
# writes the `config-drift` service_health row (ok heartbeat every clean run).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
# Root on purpose: the audit is READ-ONLY on the box (its only write is one
# Turso row over HTTPS) but must read /etc/sudoers.d (0440 root) and run
# `docker inspect` to resolve the live compose file.
User=root
WorkingDirectory=/home/radon/radon/cloud
# This unit deliberately declares NO environment-file directive. The stable
# secret file is 0600 radon:radon by design, and systemd merges every KEY=VALUE
# line of such a file into the process environment unfiltered: one LD_PRELOAD
# line appended to it would load
# radon-authored code into root on the next tick, and PATH= would redirect the
# bare `docker` / `systemctl` calls below to radon-owned binaries. The audit
# instead READS the two keys it needs out of that file as data
# (drift_audit.py:load_env_keys), which grants radon no control over root's
# execution environment.
Environment=RADON_ENV_FILE=/home/radon/radon-cloud/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Root runs the control-plane copy of the audit, installed root-owned by
# cloud/scripts/bootstrap-control-plane.sh. The checkout is the ARGUMENT it
# audits, never the code it executes: a radon-writable payload would make every
# timer tick a root shell for the unprivileged account.
# -I (isolated): CPython otherwise prepends the script's own directory to
# sys.path, so a module dropped beside the audit (difflib.py) would be imported
# by root.
ExecStart=/usr/bin/python3 -I /usr/local/lib/radon/drift_audit.py /home/radon/radon/cloud
# A oneshot with no runtime ceiling can hang forever and freeze its timer
# (the ib-watchdog self-hang, 2026-06-10) -- bound the whole run.
TimeoutStartSec=180
