[Unit]
Description=Radon Bullish Percent Index scan (bpi_scan.py NDX/SPX/RUT, P&F buy-signal breadth)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/bpi_scan.py --index all
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
