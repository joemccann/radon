[Unit]
Description=Radon Bullish Percent Index scan (bpi_scan.py NDX/SPX/RUT, P&F buy-signal breadth)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/bpi_scan.py --index all
StandardOutput=journal
StandardError=journal
# Weekday evenings the ENTIRE ~2,600-member universe is one session stale,
# so the "incremental" is a full-universe refetch (~35-45 min with Yahoo
# courtesy sleeps; NDX alone measured 13 min). 1200s killed the 2026-07-27
# run mid-SPX (Result=timeout). 2026-07-27 follow-up: Yahoo's tarpit
# (reactive to the day's hammering) priced even valid 20-symbol spark
# chunks at ~60s — a fully tarpitted sweep measured 105 min (6300s).
# Normal-pace sweep is ~3 min.
# R-071: the budget must ALSO end before the 23:30 UTC catch-up fire — a
# oneshot still activating when its timer fires swallows that fire, and
# the catch-up exists precisely to recover a lagging 21:30 run. The
# inter-fire gap is 7200s, worst-compressed to 7080s by the timer's
# RandomizedDelaySec=120 on the first fire; 6900 stays under it with
# margin while still covering the measured tarpit worst case.
TimeoutStartSec=6900

[Install]
WantedBy=multi-user.target
