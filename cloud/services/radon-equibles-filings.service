[Unit]
Description=Radon Equibles Filing Forensics (Form 144, ATM shelves, buybacks, exec changes)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_equibles_filing_forensics.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
