[Unit]
Description=Radon Flex sFTP pull (OpenSSH IPv4 client)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
UMask=0077
WorkingDirectory=/home/radon/radon
# Not /etc/radon/env: that file carries TWS_PASSWORD. Turso + sFTP live here.
EnvironmentFile=-/var/lib/radon/flex-secrets/env
Environment=RADON_DB_NO_REPLICA=1
ExecStartPre=+/usr/bin/install -d -o radon -g radon -m 0700 /var/lib/radon/flex-inbox
ExecCondition=/usr/bin/test -f /home/radon/radon/scripts/flex_sftp_pull.py
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/flex_sftp_pull.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
InaccessiblePaths=-/etc/radon/env -/home/radon/radon-cloud/.env
ReadWritePaths=/var/lib/radon/flex-inbox /var/lib/radon/flex-secrets /home/radon/radon/data
# Ingest atomic-writes sibling caches across data/ (performance.json,
# cash_flows.json, nav caches), so the dir grant is required -- but the
# journal and portfolio must never be writable from this unit. Deepest
# path wins, so these file binds override the data/ grant above.
ReadOnlyPaths=-/home/radon/radon/data/trade_log.json -/home/radon/radon/data/portfolio.json

[Install]
WantedBy=multi-user.target
