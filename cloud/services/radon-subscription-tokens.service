[Unit]
Description=Radon subscription token vault (seal, refresh, probe, restore, push-login agent CLI credentials)
After=network.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/
Environment=RADON_RUNTIME=container
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Delegate=yes
KillMode=mixed
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
Environment=RADON_SECRET_STORE_PATH=/home/radon/radon/data/secret_store/secrets.db
# Root dispatches the release image; CLI execution and credentials stay isolated.
LoadCredentialEncrypted=radon-secret-store-key:/etc/credstore.encrypted/radon-secret-store-key
# The sidecar /var/lib/radon/subscription-tokens/state.json carries the page
# cooldowns and the consecutive-error streak. Without this the directory is not
# owned by radon and every run silently loses both.
StateDirectory=radon
StateDirectoryMode=0750
ExecStart=/usr/local/sbin/radon-app-runtime run %n
ExecStop=/usr/local/sbin/radon-app-runtime halt %n 30
ExecStopPost=/usr/local/sbin/radon-app-runtime stop %n
StandardOutput=journal
StandardError=journal
# --once exits 1 whenever a provider is needs_reauth or error, which is the
# steady state this unit exists to report and which the module already pages
# for at normal priority. Without this the oneshot latches ActiveState=failed on
# every fire, the watchdog never matches its exit-code latch, and one revoked
# refresh token becomes an hour-long P1 emergency siren every day. 78
# (store_unavailable) is deliberately still a failure: that one warrants P1.
SuccessExitStatus=1
# Per provider the ceiling is a 150s CLI probe + 20s OIDC discovery + two 63s
# POST envelopes (form, then the JSON retry): ~296s, and one push login can
# hold the run for up to 600s. That sum does not fit a 30min slot, so the module
# budgets itself: inside RUN_BUDGET_SECONDS (1500s) it starts no probe with
# under 150s left, no refresh with under 170s left, and clips the login wait to
# what remains. This kill is the backstop behind that budget, kept under the
# 30min slot so a hung run cannot block the next refresh.
TimeoutStartSec=1700

[Install]
WantedBy=multi-user.target
