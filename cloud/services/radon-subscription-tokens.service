[Unit]
Description=Radon subscription refresh request through the private model gateway
Wants=radon-model-gateway.service
After=radon-model-gateway.service
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
UMask=0077
WorkingDirectory=/home/radon/radon
Environment=RADON_MODEL_CONTROL_SOCKET=/run/radon-model-control/control.sock
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The existing thirty-minute timer submits/polls a bounded refresh job.
# Vendor authentication, probes, rotation and sealing execute only inside
# the gateway's immutable image. This client receives no provider grants,
# database credentials, paging keys, vault socket or store master key.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
ProtectSystem=full
CapabilityBoundingSet=
ProtectProc=invisible
InaccessiblePaths=-/etc/radon/env -/etc/radon/subscription-tokens/env -/run/radon-subscription-vault -/home/radon/.grok -/home/radon/.codex -/home/radon/.claude -/home/radon/.gemini
ExecStart=/home/radon/radon/.venv/bin/python -m scripts.model_gateway.refresh_cli
StandardOutput=journal
StandardError=journal
# Needs-reauth/error is already paged by the lifecycle worker. Store/RPC
# failures remain failures (78), never a false healthy credential state.
SuccessExitStatus=1
TimeoutStartSec=1700

[Install]
WantedBy=multi-user.target
