[Unit]
Description=Radon subscription token vault (seal, refresh, probe, restore, push-login agent CLI credentials)
# DS-2026-10-05-05: the vault broker holds the secret-store key; this unit
# reaches the four CLI credential slots only through its socket.
Wants=radon-subscription-vault.service
After=network.target radon-subscription-vault.service
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
UMask=0077
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
Environment=RADON_SUBSCRIPTION_VAULT_SOCKET=/run/radon-subscription-vault/vault.sock
# The Antigravity and Grok installers place `agy` and `grok` in ~/.local/bin;
# the daemon prefers each CLI-native refresh. (The module also searches that
# directory itself, so a manual run outside this unit finds them too.)
Environment=PATH=/home/radon/.local/bin:/usr/local/bin:/usr/bin:/bin
# The CLIs this unit runs (agy, grok, codex) are unpinned third-party
# binaries out of radon-writable ~/.local/bin, with the production env file
# loaded, so the unit holds no secret-store key (DS-2026-10-05-05): the
# broker radon-subscription-vault does. ProtectSystem=strict is off the
# table because the unit rewrites credential files across /home/radon;
# everything else closes.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
ProtectSystem=full
CapabilityBoundingSet=
# systemd reads EnvironmentFile before the namespace is built, so hiding the
# file from the process costs this unit nothing and stops the three unpinned
# agent CLIs it launches from reading the production credentials straight off
# disk (ProtectSystem=full restricts writes, not reads). Same contract as the
# two grok units. Residual, which no namespace option closes: those CLIs run
# under the same uid as this process, so /proc/<parent>/environ still carries
# whatever systemd loaded here — closing that needs a separate account.
InaccessiblePaths=-/etc/radon/env
ProtectProc=invisible
# The sidecar /var/lib/radon/subscription-tokens/state.json carries the page
# cooldowns and the consecutive-error streak. Without this the directory is not
# owned by radon and every run silently loses both.
StateDirectory=radon
StateDirectoryMode=0750
ExecStart=/home/radon/radon/.venv/bin/python -m scripts.subscription_tokens --once
StandardOutput=journal
StandardError=journal
# --once exits 1 whenever a provider is needs_reauth or error, which is the
# steady state this unit exists to report and which the module already pages
# for at normal priority. Without this the oneshot latches ActiveState=failed on
# every fire, the watchdog never matches its exit-code latch, and one revoked
# refresh token becomes an hour-long P1 emergency siren every day. 78
# (store_unavailable) is deliberately still a failure: that one warrants P1.
SuccessExitStatus=1
# Per provider the ceiling is a 150s CLI probe + 20s OIDC discovery + two 63s
# POST envelopes (form, then the JSON retry): ~296s, and one push login can
# hold the run for up to 600s. That sum does not fit a 30min slot, so the module
# budgets itself: inside RUN_BUDGET_SECONDS (1500s) it starts no probe with
# under 150s left, no refresh with under 170s left, and clips the login wait to
# what remains. This kill is the backstop behind that budget, kept under the
# 30min slot so a hung run cannot block the next refresh.
TimeoutStartSec=1700

[Install]
WantedBy=multi-user.target
