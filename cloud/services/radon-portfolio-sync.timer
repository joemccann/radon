[Unit]
Description=Radon portfolio refresh - every minute during the ET extended session

[Timer]
# Fires every minute Mon-Fri 04:00-19:59 ET, matching fill_monitor's
# session_window=equity_ext (04:00-20:00 ET). outsideRth orders fill in
# pre-market and after-hours, and those fills already mirror into
# executed_orders and raise a FILLED toast; an RTH-only window here left
# the positions table pre-fill until the next cash open.
# run_portfolio_refresh.sh re-checks is_equity_ext_session_et() at runtime,
# so holidays, IBKR `closed` days and the 20:00 boundary still exit 0.
OnCalendar=Mon..Fri *-*-* 04..19:*:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
