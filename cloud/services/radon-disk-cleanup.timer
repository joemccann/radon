[Unit]
Description=Radon disk cleanup -- weekly sweep Sunday off-hours, hourly headroom guard

[Timer]
# Sunday 03:20 UTC: the weekend slot the operator asked for, and deliberately
# clear of every DB-maintenance window -- portfolio-archive (05:40 + 2h),
# db-retention (08:10), db-backup (09:00) -- and of the 02:15/02:20/02:35
# nightly cluster above it. Not :00/:30 to stay off the top-of-hour scheduler
# herd.
OnCalendar=Sun *-*-* 03:20:00 UTC
# Hourly headroom guard (2026-11-01): root reached 3.1 GiB free mid-week and a
# deploy was refused at 6.2G, so a human ran this oneshot. disk_cleanup.py
# treats every timer firing outside the Sunday 03:xx UTC slot as the guard: it
# exits at once while free space is at or above HEADROOM_THRESHOLD_BYTES,
# never waits on a deploy, and otherwise reclaims and heartbeats `error` when
# it cannot restore headroom. :50 plus the 300s spread never reaches 03:xx.
OnCalendar=*-*-* *:50:00 UTC
RandomizedDelaySec=300
# NO Persistent=true, deliberately. A missed firing replaying at boot voids
# this timer's own "Sunday 03:20 UTC, clear of every DB-maintenance window"
# argument above: a Tuesday 14:30 UTC reboot after a missed Sunday would replay
# a DESTRUCTIVE sweep during US market hours, rmtree-ing caches, removing app
# images and vacuuming journald while live trading and possibly a deploy are in
# progress. Missing one weekly reclaim costs a week of disk; replaying it into
# an active session costs the session. R-369. The hourly guard does run during
# market hours, but only below the threshold, where ENOSPC is the larger risk.

[Install]
WantedBy=timers.target
