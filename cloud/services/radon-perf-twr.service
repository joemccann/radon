[Unit]
Description=Radon TWR performance builder (Flex EquitySummaryInBase + external flows)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/perf_twr_builder.py
StandardOutput=journal
StandardError=journal
# Derived from perf_twr_builder.FLEX_POLL_BUDGET_SECONDS (420s), which is now
# a WALL-CLOCK deadline covering both the poll sleeps and the GetStatement
# reads (R-103). resolve_flows reuses the one NAV document, so a run makes one
# Flex request chain. 600s = the 420s budget plus SendRequest, parse and write.
# Pinned by scripts/tests/test_nested_deadlines.py.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
