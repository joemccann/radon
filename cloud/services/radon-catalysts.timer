[Unit]
Description=Radon catalyst feed — three trading-day refreshes

[Timer]
# Pre-market, mid-session, and close refreshes keep exact-time economic events
# and newly scheduled catalysts current. run_catalysts.sh re-checks the trading
# calendar and exits 0
# on US holidays. Was laptop-launchd-only until 2026-07-02 — prod served
# missing:true whenever the laptop was asleep; now the VPS owns it and
# fetch_catalysts dual-writes Turso (catalysts table) + data/catalysts.json.
OnCalendar=Mon..Fri *-*-* 06:30:00 America/New_York
OnCalendar=Mon..Fri *-*-* 10:00:00 America/New_York
OnCalendar=Mon..Fri *-*-* 16:00:00 America/New_York
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
