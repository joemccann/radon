[Unit]
Description=Radon nightly Turso DB backup (full sqlite_master dump + 30d prune)
After=network.target
# DUR-02 pattern: brake crash loops -- after StartLimitBurst starts inside
# StartLimitIntervalSec, systemd parks the unit as failed instead of
# restarting forever. The db-backup service_health heartbeat (48h window)
# surfaces a parked/silent backup on the dashboard + watchdog daily bucket.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
UMask=0077
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/usr/bin/flock -w 7500 -E 75 /run/lock/radon-db-maintenance.lock /home/radon/radon/.venv/bin/python /home/radon/radon/cloud/scripts/db_backup.py
# R-067: a lock loser (peer still holding /run/lock/radon-db-maintenance.lock
# past the 7500s wait) exits 75 (EX_TEMPFAIL) and defers to its next timer
# slot instead of entering failed; 75 is reserved for flock — db_backup.py
# never exits with it. The 48h db-backup service_health window still pages
# if deferral persists.
SuccessExitStatus=75
StandardOutput=journal
StandardError=journal
# libsql_experimental exposes NO client-side timeouts (DUR-09); this
# process-level bound is the only real one for a wedged cloud connection.
# The DB is ~1.4 GB and direct-to-cloud reads run ~1 MB/s, so a healthy
# full dump takes ~20-25 min. 19500 = full 7500s lock wait + the 12000s
# work ceiling, so winning the lock late never eats the work budget.
TimeoutStartSec=19500

[Install]
WantedBy=multi-user.target
