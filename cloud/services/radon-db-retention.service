[Unit]
Description=Radon Turso snapshot retention sweep (keep-latest on append-only scan tables)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecCondition=/usr/bin/test -f /home/radon/radon/scripts/db_retention_sweep.py
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/db_retention_sweep.py
StandardOutput=journal
StandardError=journal
# Unbounded libsql client — process bound is the real one. Normal sweep is
# seconds to a few minutes once tables are already near retention; 30m
# absorbs a first-run catch-up on gex/vcg history.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
