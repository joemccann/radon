[Unit]
Description=Radon Panic Proxy - Cboe VIX/VIX3M/VVIX/SKEW composite, every 5 minutes in ET trading hours plus 16:01 ET and 13:15 UTC

[Timer]
# Intraday fires add a provisional current-session row (IB pool bars, else Cboe
# 15-minute delayed quotes) in the small panic-index:live snapshot; it never
# alerts. Official CSV rows land on the first fire after Cboe appends them:
# VIX and VIX3M carry the prior session by ~01:51 UTC (vixts research), VVIX
# and SKEW were observed re-touched at 12:01 and 21:01 UTC.
OnCalendar=Mon..Fri *-*-* 09..16:00,05,10,15,20,25,30,35,40,45,50,55 America/New_York
# 16:01 ET (13:01 PT) samples the closing quotes; 13:15 UTC (before RTH open)
# is kept as specified. Off-session fires are 304 heartbeats that keep
# service_health inside the 26h window.
OnCalendar=*-*-* 16:01:00 America/New_York
OnCalendar=*-*-* 13:15:00 UTC
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
