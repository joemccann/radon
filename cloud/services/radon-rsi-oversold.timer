[Unit]
Description=Radon RSI OVERSOLD Indicator - daily 16:40 ET SPX RSI breadth

[Timer]
# 16:40 America/New_York: forty minutes after the 16:00 ET close, across DST,
# and twenty minutes behind radon-ma-ratio's 16:20 pass so the shared
# member-close sweep is already fresh. Was 23:05 UTC (19:05 EDT), which left
# the tab a session behind for most of the evening (2026-10-23). Runs every
# calendar day: weekend and holiday runs recompute identical rows (idempotent
# upsert) and act as unchanged-data heartbeats that keep service_health fresh
# inside the 26h staleness window (the ivrank convention).
OnCalendar=*-*-* 16:40:00 America/New_York
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
