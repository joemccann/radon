[Unit]
Description=Radon IB Gateway remote-control daemon (broker private-net mTLS)
# Broker-only. App and combined hosts skip this unit at control-plane refresh.
# No Requires=/PartOf= on radon-ib-gateway: a Gateway stop must not kill the
# path the app host uses to start it again.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=radon
# REL-200 (R-567): the stop/start verb cooldown persists here so a daemon
# restart between stop and start cannot re-enable a stacked-2FA-push sequence.
StateDirectory=radon-ib-remote
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_IB_REMOTE_BIND=10.0.0.4
Environment=RADON_IB_REMOTE_PORT=8340
Environment=RADON_IB_REMOTE_ALLOW=10.0.0.2
TasksMax=32
MemoryMax=256M
# REL-168 (R-497): a network-exposed daemon that execs a Docker-mutating
# helper. The helper (as radon) writes the 2FA lease, control guard and
# transition file under /var/lib/radon and takes the deploy lock under
# /home/radon, so those stay writable; everything else is read-only.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/radon /home/radon
ExecStart=/home/radon/radon/.venv/bin/python -m scripts.ib_gateway_remote.serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
