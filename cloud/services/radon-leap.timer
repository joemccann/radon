[Unit]
Description=Radon LEAP scan — once per US trading day at 10:00 ET

[Timer]
# Fires once daily at 14:00 UTC — early enough in the US session that
# the LEAP tab on the dashboard has fresh data well before midday, late
# enough that the morning open chop has settled. The run_leap_refresh.sh
# wrapper re-checks the trading calendar at runtime and exits 0 on US
# holidays before doing any work.
OnCalendar=Mon..Fri *-*-* 10:00:00 America/New_York
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
