[Unit]
Description=Radon Flex sFTP pull - morning after Flex finalizes the session

[Timer]
# Tue..Sat 07:30 ET picks up the prior session. 08:30 ET is the empty-dir
# list-dir retry. Empty outgoing is ok (wait), not a page.
OnCalendar=Tue..Sat *-*-* 07:30:00 America/New_York
OnCalendar=Tue..Sat *-*-* 08:30:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
