[Unit]
Description=Radon Grok CLI/model daily upgrade (track latest, auto-promote)
After=network.target

# Daily oneshot. A failed smoke stays on last-known-good and pages via
# the unit watchdog plus Pushover. Promotion takes the shared runtime lock
# so it never swaps the live binary during an incident run.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon-page-responder
EnvironmentFile=/home/radon/radon-page-responder.env
Environment=GROK_PAGE_NO_DOTENV=1
Environment=HOME=/home/radon
Environment=PATH=/home/radon/.local/bin:/home/radon/.grok/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1200
ExecStart=/home/radon/radon-page-responder/.venv/bin/python /home/radon/radon-page-responder/scripts/grok_upgrade.py --grok-bin /home/radon/.local/bin/grok --live-bin /home/radon/.local/bin/grok --alias-bin /home/radon/.grok/bin/grok --lkg /var/lib/radon/grok_lkg.json --lock /var/lib/radon/grok-runtime/grok-runtime.lock --scratch /var/lib/radon/grok-upgrade
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
InaccessiblePaths=/var/run/docker.sock /usr/bin/docker /usr/local/sbin/radon-deploy-root /home/radon/radon-cloud -/etc/radon/env /home/radon/radon-page-responder.env -/var/lib/radon/flex-secrets -/var/lib/radon/rh-mcp -/home/radon/.ssh -/home/radon/.claude -/home/radon/.claude.json -/home/radon/.codex -/home/radon/.gnupg -/home/radon/.config/gh -/home/radon/.git-credentials
ReadOnlyPaths=/home/radon
# The candidate install and smoke scratch live under /var/lib/radon/grok-upgrade,
# outside the page responder's write set, because the promoted live symlink
# points into it.
ReadWritePaths=/home/radon/radon-page-responder /home/radon/.grok /home/radon/.local /var/lib/radon

[Install]
WantedBy=multi-user.target
