[Unit]
Description=Radon Credit Spread Indicator (Yahoo HYG vs S&P 500 daily close pull)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_credit_spread.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
