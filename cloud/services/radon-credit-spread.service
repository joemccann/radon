[Unit]
Description=Radon Credit Spread Indicator (IB HYG vs S&P 500 daily close pull)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
# R-127: this job and radon-iei-hyg share IB client IDs 56/69. The
# 21:45/21:55 gap is not a mutex — RandomizedDelaySec=300 on both timers
# can start credit-spread at 21:50 with 300s of work left to run. -w
# outlasts the peer's whole TimeoutStartSec (600s) so the loser never
# gives up into the same collision; -E 75 + SuccessExitStatus=75 defer
# to the next slot instead of entering failed (same shape as R-067's
# db-maintenance lock).
ExecStart=/usr/bin/flock -w 660 -E 75 /run/lock/radon-ib-history-5669.lock /home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_credit_spread.py
SuccessExitStatus=75
StandardOutput=journal
StandardError=journal
# 660s lock wait + the 300s work ceiling.
TimeoutStartSec=960

[Install]
WantedBy=multi-user.target
