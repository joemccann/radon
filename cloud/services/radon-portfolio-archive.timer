[Unit]
Description=Radon portfolio_snapshots cold-archive — nightly before retention/backup

[Timer]
# 05:40 UTC: off-hours, alone on the Turso write path. Must NOT overlap
# db-retention (was 07:22 while archive still ran to 07:54 on 2026-07-12 —
# concurrent DELETE storms timed out every key for ~1h). Deliberately not
# :00/:30. Persistent so a missed firing replays on next boot.
OnCalendar=*-*-* 05:40:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
