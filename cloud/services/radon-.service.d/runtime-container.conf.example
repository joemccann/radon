# Example only. MUST NOT be installed by setup-vps.sh or
# bootstrap-control-plane.sh. Default runtime remains host binaries.
#
# DO NOT copy this fleet drop-in to radon-.service.d/. Prefix matching
# would override radon-ib-gateway.service and radon-health.service.
# Use the per-unit examples next to each app unit instead.
#
# After-hours cutover: copy each unit example to
# /etc/systemd/system/<unit>.d/runtime-container.conf then daemon-reload
# and restart-managed. Do not restart Gateway.
