[Unit]
Description=Radon Grok CLI/model pin bump (disabled until Joe enables it)
After=network.target

# Weekly candidate check. Do not enable this timer until the pin file and
# smoke path have been reviewed. A failed oneshot pages via the unit watchdog.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon-page-responder
EnvironmentFile=/home/radon/radon-page-responder.env
Environment=GROK_PAGE_NO_DOTENV=1
Environment=HOME=/home/radon
Environment=PATH=/home/radon/.local/bin:/home/radon/.grok/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1200
ExecStart=/home/radon/radon-page-responder/.venv/bin/python /home/radon/radon-page-responder/scripts/grok_pin_bump.py --repo /home/radon/radon-page-responder --scratch /home/radon/radon-page-responder/data/cache/grok_pin_bump
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
InaccessiblePaths=/var/run/docker.sock /usr/bin/docker /usr/local/sbin/radon-deploy-root /home/radon/radon-cloud -/etc/radon/env
ReadOnlyPaths=/home/radon
ReadWritePaths=/home/radon/radon-page-responder /home/radon/.grok

[Install]
WantedBy=multi-user.target
