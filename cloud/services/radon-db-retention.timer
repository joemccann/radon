[Unit]
Description=Radon Turso snapshot retention sweep — daily off-hours

[Timer]
# 08:10 UTC: AFTER portfolio-archive's TimeoutStartSec=7200 window (05:40 +
# 2h = 07:40) so the two never contend on Turso DELETEs (2026-07-12
# concurrent storm). BEFORE db-backup (09:00) so the dump sees pruned tables.
OnCalendar=*-*-* 08:10:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
