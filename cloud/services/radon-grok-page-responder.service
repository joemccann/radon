[Unit]
Description=Radon Grok P1 page responder (dedicated clone, stripped env)
After=network.target
# Poller: do not park on start-limit. Failures are ticket attempts in Turso.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon-page-responder
# NEVER /home/radon/radon-cloud/.env or /etc/radon/env — those carry IB Flex,
# Clerk, UW, archive (T-134: the secrets moved to /etc/radon/env in a0716084).
EnvironmentFile=/home/radon/radon-page-responder.env
Environment=GROK_PAGE_NO_DOTENV=1
Environment=GROK_PAGE_SYNC_REMOTE=1
Environment=HOME=/home/radon
Environment=PATH=/home/radon/.local/bin:/home/radon/.grok/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=3900
ExecStart=/home/radon/radon-page-responder/.venv/bin/python /home/radon/radon-page-responder/scripts/grok_page_responder.py
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
# The stripped EnvironmentFile above is pointless if the agent can read the
# real secrets off disk: /home/radon/radon-cloud/.env is 0600 radon-owned and
# this unit runs as radon. ProtectHome=tmpfs would also hide the clone and the
# venv it executes from, so the secrets are denied by path instead. The
# unit's own env file is read by systemd before the namespace exists, so it
# is hidden too; grok children also get an allowlisted env (grok_runtime).
# flex-secrets and rh-mcp hold other units' credentials under /var/lib/radon.
InaccessiblePaths=/var/run/docker.sock /usr/bin/docker /usr/local/sbin/radon-deploy-root /home/radon/radon-cloud -/etc/radon/env /home/radon/radon-page-responder.env -/var/lib/radon/flex-secrets -/var/lib/radon/rh-mcp
# ~/.grok/bin, ~/.local/bin (read-only via /home/radon) and the promoted
# candidate under /var/lib/radon/grok-upgrade are executed by the
# secret-bearing subscription-tokens unit; ~/.grok/hooks is run by grok
# itself. None of them may be writable here.
ReadOnlyPaths=/home/radon /var/lib/radon -/home/radon/.grok/bin -/home/radon/.grok/hooks -/home/radon/.grok/downloads
# The grok CLI writes its session state under ~/.grok; with only the clone
# writable every fix attempt died at session creation ("Read-only file
# system"), each page burned its 3 attempts and was skipped — the responder
# polled healthily while fixing nothing (Aug 15–20 outage). The shared
# runtime flock lives in its own dir so /var/lib/radon stays read-only.
ReadWritePaths=/home/radon/radon-page-responder /home/radon/.grok -/var/lib/radon/grok-runtime

[Install]
WantedBy=multi-user.target
