[Unit]
Description=Radon Grok P1 page responder (dedicated clone, stripped env)
Wants=radon-model-gateway.service
After=network.target radon-model-gateway.service
# Poller: do not park on start-limit. Failures are ticket attempts in Turso.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon-page-responder
# NEVER /home/radon/radon-cloud/.env or /etc/radon/env — those carry IB Flex,
# Clerk, UW, archive (T-134: the secrets moved to /etc/radon/env in a0716084).
EnvironmentFile=/home/radon/radon-page-responder.env
Environment=GROK_PAGE_NO_DOTENV=1
Environment=GROK_PAGE_SYNC_REMOTE=1
Environment=HOME=/home/radon
Environment=GROK_BIN=/opt/radon-model-clients/current/bin/grok
Environment=RADON_MODEL_GATEWAY_SOCKET=/run/radon-model-gateway/gateway.sock
Environment=PATH=/opt/radon-model-clients/current/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=3900
ExecStart=/usr/bin/env GROK_BIN=/opt/radon-model-clients/current/bin/grok RADON_MODEL_GATEWAY_SOCKET=/run/radon-model-gateway/gateway.sock /home/radon/radon-page-responder/.venv/bin/python /home/radon/radon-page-responder/scripts/grok_page_responder.py
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
# /etc/radon/env is root-owned; /home/radon/radon-cloud/.env is retired.
# Deny both paths so this radon process cannot read live or legacy secrets.
# ProtectHome=tmpfs would also hide the clone and the venv it executes from,
# so the secrets are denied by path instead. The
# unit's own env file is read by systemd before the namespace exists, so it
# is hidden too; grok children also get an allowlisted env (grok_runtime).
# flex-secrets and rh-mcp hold other units' credentials under /var/lib/radon.
# HOME is /home/radon, so the home credential stores (SSH key, agent CLI
# sessions, GPG, gh/git credentials) are denied too; main syncs over HTTPS.
InaccessiblePaths=/var/run/docker.sock /usr/bin/docker /usr/local/sbin/radon-deploy-root /home/radon/radon-cloud -/etc/radon/env /home/radon/radon-page-responder.env -/run/radon-subscription-vault -/run/radon-model-control -/home/radon/.grok -/var/lib/radon/flex-secrets -/var/lib/radon/rh-mcp -/home/radon/.ssh -/home/radon/.claude -/home/radon/.claude.json -/home/radon/.codex -/home/radon/.gemini -/home/radon/.gnupg -/home/radon/.config/gh -/home/radon/.git-credentials
# Native clients are promoted from the exact CI image and remain root-owned.
# The app-scoped bridge uses private temporary authentication state.
ReadOnlyPaths=/home/radon /var/lib/radon -/home/radon/.grok/bin -/home/radon/.grok/hooks -/home/radon/.grok/downloads
# Repository execution and the shared local runtime lock remain writable;
# provider grants are inaccessible and temporary bridge state stays in /tmp.
ReadWritePaths=/home/radon/radon-page-responder -/var/lib/radon/grok-runtime

[Install]
WantedBy=multi-user.target
