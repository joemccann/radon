[Unit]
Description=Radon VIX TS Indicator - every 5 minutes in ET trading hours plus daily 16:01 ET

[Timer]
# Intraday fires add a provisional current-session row (IB pool bars, else Cboe
# 15-minute delayed quotes) in the small vixts:live snapshot, and pick up the
# official VIX/VIX3M CSV rows on the first fire after Cboe stamps them
# (observed 01:50 UTC VIX, 22:00 UTC VIX3M on 2026-08-26).
OnCalendar=Mon..Fri *-*-* 09..16:00,05,10,15,20,25,30,35,40,45,50,55 America/New_York
# 16:01 ET (13:01 PT) every calendar day samples the closing quotes. Weekend and
# holiday runs are 304 heartbeats that keep service_health inside the 26h window.
OnCalendar=*-*-* 16:01:00 America/New_York
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
