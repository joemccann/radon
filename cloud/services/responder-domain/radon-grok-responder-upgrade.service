[Unit]
Description=Radon isolated responder model gateway readiness (legacy unit name)
Wants=radon-model-gateway.service
After=network.target radon-model-gateway.service
ConditionPathExists=/var/lib/radon-responder/ready
ConditionPathExists=/opt/radon-model-clients/current/manifest.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=radon-responder
Group=radon-responder
SupplementaryGroups=radon-model-connect
UMask=0027
WorkingDirectory=/var/lib/radon-responder/upgrade
EnvironmentFile=/etc/radon/grok-responder/env
Environment=GROK_PAGE_NO_DOTENV=1
Environment=HOME=/var/lib/radon-responder
Environment=PATH=/opt/radon-model-clients/current/bin:/usr/local/bin:/usr/bin:/bin
Environment=RADON_MODEL_GATEWAY_SOCKET=/run/radon-model-gateway/gateway.sock
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/usr/bin/python3.13 -I -S /opt/radon-model-clients/current/lib/model_gateway/cli.py status
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectHome=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
CapabilityBoundingSet=
InaccessiblePaths=-/run/radon-model-control -/run/radon-subscription-vault -/var/lib/radon-responder/.grok /var/run/docker.sock /usr/bin/docker /usr/local/sbin/radon-deploy-root /var/lib/radon-responder/repo -/etc/radon/env /etc/radon/grok-responder -/var/lib/radon/flex-secrets -/var/lib/radon/rh-mcp
ReadOnlyPaths=/opt/radon-model-clients

[Install]
WantedBy=multi-user.target
