[Unit]
Description=Radon knowledge-base ingest (connectors -> distill -> embed -> Turso knowledge table)
After=network.target

# DUR-02 (2026-06-12): brake crash loops — after StartLimitBurst starts inside
# StartLimitIntervalSec, systemd parks the unit as failed (Result=start-limit-hit)
# instead of restarting forever (radon-beta-nextjs hit 160k restarts in 10 days).
# The unit watchdog (radon main repo scripts/watchdog/units.py, continuous bucket)
# alerts on failed/start-limit-hit so the brake never becomes a silent outage.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
# fastembed defaults its model cache to /tmp/fastembed_cache, which is
# ephemeral — pin it so the ~67 MB bge-small-en-v1.5 ONNX model downloads
# once and survives /tmp cleanup.
Environment=FASTEMBED_CACHE_PATH=/home/radon/.cache/fastembed
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/knowledge/ingest.py --source all
StandardOutput=journal
StandardError=journal
# Steady-state runs are minutes (pre-filter skips unchanged docs before any
# LLM call), but a cold run distills a multi-thousand-doc backlog through
# Cerebras (8 workers) and downloads the embedding model. 30 min bounds a
# wedged run well inside the hourly timer slot.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
