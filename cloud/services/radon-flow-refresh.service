[Unit]
Description=Radon dashboard flow refresh (scanner + flow_analysis + discover via FastAPI)
After=network.target radon-api.service
Wants=radon-api.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_UW_CALLER=flow-refresh
ExecStart=/usr/bin/bash /home/radon/radon/scripts/run_flow_refresh.sh
# R-265: SuccessExitStatus=75 is deliberately ABSENT. The wrapper already
# remaps an all-shed run to exit 0, so the mapping was redundant for the case
# it named — and 75 is EX_TEMPFAIL generally, so it also made a permanently
# shedding unit (itself the incident) indistinguishable from a clean run in
# `systemctl is-failed`, in the unit watchdog and in the journal's Result=.
# A shed now writes a `flow-refresh` service_health row instead, which is a
# signal the watchdog can actually act on.
StandardOutput=journal
StandardError=journal
# Three sequential POSTs, each bounded at 180s by the wrapper curl deadline.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
