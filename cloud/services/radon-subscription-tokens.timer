[Unit]
Description=Radon subscription token refresh (every 30 minutes)

[Timer]
# Cadence is 30 minutes. A one-hour token stays inside its life only when
# EXPIRY_SKEW_SECONDS in scripts/subscription_tokens.py exceeds this cadence
# plus RandomizedDelaySec. Explicit UTC: the schedule is DST-independent.
OnCalendar=*-*-* *:00,30:00 UTC
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
