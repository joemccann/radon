[Unit]
Description=Radon VOL CONE Indicator (UW expiry-local ATM + 10% OTM wing IV, EOD)
After=network.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_vol_cone.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
