[Unit]
Description=Radon portfolio_snapshots cold-archive (tiered storage + Turso prune)
After=network.target
# DUR-02 pattern: brake crash loops — after StartLimitBurst starts inside
# StartLimitIntervalSec, systemd parks the unit as failed instead of
# restarting forever. The portfolio-archive service_health heartbeat
# (48h window) surfaces a parked/silent archive on the dashboard +
# watchdog daily bucket.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
Environment=RADON_DB_NO_REPLICA=1
# Script ships with the MAIN repo and lands on the next deploy. Until then
# this condition skips the run CLEANLY (unit ends inactive, not failed).
ExecCondition=/usr/bin/test -f /home/radon/radon/scripts/archive_portfolio_snapshots.py
# Off-box upload required: RADON_ARCHIVE_S3_* (Backblaze B2) in EnvironmentFile.
# Local partitions still written under RADON_ARCHIVE_DIR; job fails closed if
# S3 is unset (no --allow-delete-without-upload).
ExecStart=/usr/bin/flock -w 7500 /run/lock/radon-db-maintenance.lock /home/radon/radon/.venv/bin/python /home/radon/radon/scripts/archive_portfolio_snapshots.py
StandardOutput=journal
StandardError=journal
# Healthy steady-state prune is minutes; a first catch-up of a fat backlog
# needs room for paged archive + single-key delete fallback. 2h is the
# scheduling contract with db-retention (08:10 UTC) — do not raise without
# also moving that timer later.
TimeoutStartSec=8000

[Install]
WantedBy=multi-user.target
