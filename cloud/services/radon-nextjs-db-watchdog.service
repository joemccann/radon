[Unit]
Description=Radon Next.js DB-read deep-probe watchdog (catches in-process Turso wedges the TCP liveness probe misses)
After=network.target radon-nextjs.service
Wants=radon-nextjs.service

# DUR-02: brake crash loops. Burst=10 (not 5): this unit fires on a 60s
# timer, so healthy operation is already 5 starts per 300s — Burst=5 would
# start-limit-hit a HEALTHY unit (see radon-ib-watchdog.service).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
# NOT root. The probe execs the radon-owned venv interpreter and imports the
# radon-writable checkout, so a root unit would run whatever the unprivileged
# account last wrote there. The one privileged step (restarting radon-nextjs)
# goes through the argument-validating operator granted by
# config/sudoers.d/radon-ops.
User=radon
Group=radon
WorkingDirectory=/home/radon/radon
# The state file (consecutive_wedges, last_restart_epoch) was created root:root
# while this unit still ran as root, so the first run after the demotion would
# hit PermissionError in save_state and fail EVERY tick -- including the healthy
# path, which would also stop the K=3 wedge ladder from ever accumulating. The
# "+" prefix runs this one step as root regardless of User=, so the handover is
# self-healing on the live host and needs no manual chown.
ExecStartPre=+/bin/mkdir -p /home/radon/radon-cloud/state
ExecStartPre=+/bin/chown -R radon:radon /home/radon/radon-cloud/state
EnvironmentFile=/home/radon/radon-cloud/.env
# Direct-to-cloud only; never resurrect the retired embedded replica.
Environment=RADON_DB_NO_REPLICA=1
# -I (isolated): drops the script's own directory from sys.path, so a module
# dropped beside the probe cannot shadow a stdlib import.
ExecStart=/home/radon/radon/.venv/bin/python -I /home/radon/radon/cloud/scripts/nextjs_db_watchdog.py
# Type=oneshot has NO start timeout by default — a hung probe would stall
# the every-minute timer forever. The in-script bounds (10s probe, 8s
# canary, 45s operator restart) all fit under 90s.
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
