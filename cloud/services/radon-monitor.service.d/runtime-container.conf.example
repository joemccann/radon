# Example only. MUST NOT be installed by setup-vps.sh or
# bootstrap-control-plane.sh. Default runtime remains host binaries.
#
# After hours, copy to /etc/systemd/system/radon-monitor.service.d/runtime-container.conf
#
# [Service]
# User=root
# NotifyAccess=all
# Environment=RADON_RUNTIME=container
# # Reset ExecStartPre too. systemd's User= is last-value-wins, so the
# # base unit's ExecStartPre would otherwise still run — now as root on
# # the host, against production Turso — and 203/EXEC the moment the
# # host .venv is retired as container-only. R-235.
# ExecStartPre=
# ExecStart=
# ExecStart=/usr/local/sbin/radon-app-runtime run %n
# # The container is in system.slice/docker-<id>.scope, not this unit's
# # cgroup (Docker's systemd driver takes a slice, not a unit path), so
# # KillMode=control-group reaps only the `docker run` client. Reap the
# # container explicitly or it survives holding --name and the two state
# # bind mounts. R-232.
# ExecStopPost=/usr/local/sbin/radon-app-runtime stop %n
