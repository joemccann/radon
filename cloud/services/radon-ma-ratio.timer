[Unit]
Description=Radon MA RATIO Indicator - daily 16:20 ET SPX moving-average breadth ratio

[Timer]
# 16:20 America/New_York: twenty minutes after the 16:00 ET close, across
# DST, once the closing auction has printed and the session's member candles
# have published. Was 22:45 UTC (19:45 EDT), which left the tab a session
# behind for most of the evening (2026-10-23). The slot is free of every
# other SPX constituent sweep (bpi 21:30 UTC, divyield 22:40 UTC). Runs every
# calendar day: weekend and holiday runs recompute identical rows (idempotent
# upsert) and act as unchanged-data heartbeats that keep service_health fresh
# inside the 26h staleness window (the ivrank convention).
OnCalendar=*-*-* 16:20:00 America/New_York
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
