[Unit]
Description=Radon Unusual Whales research stream collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=radon
UMask=0077
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=PYTHONPATH=/home/radon/radon/scripts
Environment=RADON_DB_NO_REPLICA=1
Environment=RADON_SECRET_STORE_PATH=/home/radon/radon/data/secret_store/secrets.db
LoadCredentialEncrypted=radon-secret-store-key:/etc/credstore.encrypted/radon-secret-store-key
ExecStartPre=/home/radon/radon/.venv/bin/python3.13 /home/radon/radon/scripts/secret_store.py
# Disabled collection remains an idle heartbeat; runtime flag comes from
# the operator environment after a redacted entitlement/channel receipt.
ExecStart=/home/radon/radon/.venv/bin/python scripts/uw_stream_collect.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
MemoryMax=768M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
