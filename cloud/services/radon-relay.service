[Unit]
Description=Radon WebSocket relay
After=network.target radon-ib-gateway.service
# Ordering only. Gateway-led starts pull relay via the Gateway unit's Wants=;
# deploy/app restarts must never pull Gateway while holding the deploy lock.
# Anti-thrash: a wedge that will not clear hits the start limit (units.py
# P1-alarms it) instead of crash-looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Type=notify + WatchdogSec (DUR-17): the relay pings WATCHDOG=1 from an
# unconditional event-loop heartbeat; a wedged loop misses the deadline and
# systemd restarts ONLY this leaf unit (no gateway touch, no 2FA). NotifyAccess
# =all because the ping is sent by a systemd-notify child PID (Node stdlib
# cannot open an AF_UNIX SOCK_DGRAM).
Type=notify
NotifyAccess=all
WatchdogSec=45
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/home/radon/radon-cloud/.env
# Relay is push-only - IB ticks fan out via WebSocket, no Turso reads.
# Avoid opening a second embedded replica on this host (one-writer rule).
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/usr/bin/node scripts/ib_realtime_server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
