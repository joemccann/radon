[Unit]
Description=Radon USI ASK-BID trade-count imbalance (TradingView)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=radon
WorkingDirectory=/home/radon/radon
EnvironmentFile=/etc/radon/env
Environment=RADON_DB_NO_REPLICA=1
ExecStart=/home/radon/radon/.venv/bin/python /home/radon/radon/scripts/fetch_imbalance.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
