[Unit]
Description=Radon demo VM - deploy the latest green main backend (pull-based)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=DEMO_ROOT=/opt/radon-demo
# Installed copy, refreshed by the agent itself after each green deploy.
ExecStart=/usr/bin/python3 -I /usr/local/lib/radon-demo/demo_vm_autodeploy.py
# A cold image build plus the remote script's 120s health gate.
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
