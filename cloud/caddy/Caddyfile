# Global options. Must be the first block in the file.
{
    # Caddy's default grace period is infinite: on reload it holds the OLD
    # servers open until every connection closes. `handle /ws*` below proxies
    # the WebSocket relay, so a single open browser socket keeps them alive
    # forever, the Type=notify unit never re-signals READY, systemd sits in
    # `reloading`, and the admin endpoint times out shutting down. A bounded
    # grace period makes `systemctl reload caddy` actually finish.
    #
    # It must be at least as long as the longest `lb_try_duration` below: the
    # deploy reloads Caddy whenever the Caddyfile changes, i.e. concurrently
    # with the upstream restarts the retry loop exists to absorb, and a
    # shorter grace hard-cut that loop during the one event it is for. R-258.
    grace_period 20s
}

{$DOMAIN:app.radon.run} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output file /var/log/caddy/radon.log
        format json
    }

    handle /ws-headlines {
        reverse_proxy 127.0.0.1:8766
    }

    handle /ws* {
        reverse_proxy 127.0.0.1:8765
    }

    # Ride out an upstream restart instead of forwarding it to the browser.
    # reverse_proxy defaults to zero retries, so every request that landed in
    # the ~7s radon-nextjs/radon-api gap of a deploy promote got a raw 502
    # (2026-08-25: /admin, /api/ib/ws-ticket, /api/portfolio). The window
    # outlasts the bounded 10s Next.js SIGTERM drain plus the restart, and is
    # short enough that a genuinely dead upstream still fails the request.
    # Do NOT add fail_duration: marking the single upstream down would take
    # the retry loop out of the picture and 502 immediately again.
    handle_path /api/ib/* {
        reverse_proxy 127.0.0.1:8321 {
            lb_try_duration 15s
            lb_try_interval 250ms

            # lb_try_* only retries a failed CONNECTION attempt. It does
            # nothing for an upstream that accepts the socket and never writes
            # a response header — the dominant radon-api failure mode here
            # (R-014's data-role lock held by a wedged gateway, R-060's zombie
            # pool client). Caddy's defaults for all three are 0 (unlimited),
            # so such a request hung forever, pinned a handler goroutine and an
            # upstream connection, and — critically — produced NO 5xx, which is
            # why @edge_health_status below could keep answering 200 through a
            # total front-end hang. R-219.
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                read_timeout 300s
            }
        }
    }

    # Hosted MCP (issue #232 chunk 1): Streamable HTTP JSON-RPC served by the
    # DEDICATED radon-mcp.service process on 8334 — never the FastAPI app on
    # 8321 and never Next.js — so an anonymous MCP caller can never reach the
    # operator /docs or /openapi.json surface through this route. `handle`
    # (not handle_path): the MCP app serves at /mcp itself. This path is
    # POST-only JSON-RPC with no idempotency key, so no lb_try_* retry loop
    # here — Caddy's default is zero retries.
    handle /mcp* {
        # T-391: anonymous internet POST into a MemoryMax=512M process —
        # bound the body at the edge so an oversized upload dies here (413)
        # instead of buffering in radon-mcp. Mirrored app-side by
        # MAX_REQUEST_BYTES in scripts/mcp_hosted/server.py.
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:8334 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                read_timeout 300s
            }
        }
    }

    # Tier-2 edge health surface. Reached Caddy->daemon DIRECTLY (never via
    # Next.js), so the health surface never re-enters the radon-nextjs cascade.
    # /edge-health/ping is a static 200 served entirely by Caddy — the never-502
    # liveness floor that depends only on Caddy being alive. /edge-health/status
    # proxies the standalone health daemon (radon-health.service :8330) and maps
    # any upstream 5xx to 200 {reachable:false} so a degraded daemon doesn't
    # surface as a raw 502.
    @edge_health_ping path /edge-health/ping
    handle @edge_health_ping {
        respond "ok" 200
    }
    @edge_health_status path /edge-health/status
    handle @edge_health_status {
        rewrite * /status
        reverse_proxy 127.0.0.1:8330 {
            # This path is anonymous internet traffic. The marker (set, so a
            # client-supplied value is overwritten) tells the daemon to answer
            # with the aggregate verdict only — no unit inventory, no
            # service_health error text, no IB auth_state.
            header_up X-Radon-Public-Edge "1"
            @down status 502 503 504
            handle_response @down {
                header Content-Type application/json
                respond `{"reachable":false,"observer":"caddy"}` 200
            }
        }
    }

    # The assistant turn is a Server-Sent Event stream.
    # 2026-08-29: the operator pasted a chart into chat and got a 504 while
    # radon-nextjs was still working on the turn. /api/assistant rode the
    # catch-all, whose R-219 guard abandons a request after 30s without a
    # response header, and the route was NON-STREAMING: it ran the whole
    # multi-round runAssistantLoop and wrote its JSON only at the end, so a
    # turn emitted no header at all until it had finished. The first mitigation
    # was a 180s bound here, which only moved the cliff.
    #
    # The route now writes `event: start` BEFORE awaiting the loop and
    # heartbeats every 10s until it is done, so the response header exists
    # within milliseconds of the request no matter how long the turn takes.
    #
    # flush_interval -1 states what must happen to those frames: forward every
    # write immediately, never batch. Caddy already infers this from the
    # text/event-stream content type, but inferring it means the fix silently
    # depends on a header the route could change; say it instead. `encode zstd
    # gzip` at the top of this site block does NOT hold the stream — its
    # writer flushes through — which cloud/tests/test_caddy_edge_timeouts.py
    # drives against a real caddy rather than assuming.
    #
    # response_header_timeout stays at 180s as a BACKSTOP, not as the
    # mechanism: it now only bounds a radon-nextjs that dies before the stream
    # opens, i.e. during Clerk verification, the durable rate limiter, or the
    # demo quota check — all of which are DB round trips and all of which run
    # before the header. It is under the route's own maxDuration 300, so the
    # edge never waits on a request the route has already abandoned.
    #
    # Scoped to this one path on purpose. Raising the guard globally would undo
    # R-219 for every other route, where an upstream that accepts the socket
    # and never writes a header must still become an observable 5xx quickly.
    #
    # No lb_try_duration here, deliberately: this path is POST-only and has no
    # idempotency key, so a retry loop could replay a vision turn the operator
    # is billed for and re-run its tool calls. Caddy's default is zero retries.
    # R-262.
    handle /api/assistant* {
        reverse_proxy 127.0.0.1:3000 {
            flush_interval -1

            transport http {
                dial_timeout 5s
                response_header_timeout 180s
                read_timeout 300s
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:3000 {
            lb_try_duration 15s
            lb_try_interval 250ms

            # This block serves POST /api/orders/place, /cancel and /modify.
            # Without lb_retry_match the restriction rests on an unpinned Caddy
            # default, and there is no idempotency key anywhere on this path
            # (R-009: orderRef never returned; R-022: no server-side submission
            # record), so nothing downstream could collapse a duplicate and the
            # operator's only evidence would be two fills. State it. R-220.
            lb_retry_match {
                method GET HEAD
            }

            # Same reasoning as the /api/ib/* block above. read_timeout is
            # generous on purpose: it bounds a dead connection without cutting
            # a legitimately streamed response. R-219.
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                read_timeout 300s
            }
        }
    }

    # handle_response on :8330 only sees an upstream HTTP 5xx. A dial refused
    # (healthd stopped during deploy) is a Caddy-synthesized 502 that never
    # matches @down. Scope this to the health paths so /ws 502s stay 502s.
    handle_errors {
        @edge_health_err path /edge-health/status /status
        handle @edge_health_err {
            header Content-Type application/json
            respond `{"reachable":false,"observer":"caddy"}` 200
        }
    }
}

# media.radon.run — static image host for newsfeed thumbnails.
# Fed by laptop newsfeed scraper via rsync over Tailscale; both
# localhost:3000 (laptop dev) and app.radon.run (Hetzner prod) read
# from this host. Caddy auto-issues Let's Encrypt TLS on first request.
media.radon.run {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Access-Control-Allow-Origin "*"
        # Image filenames are content-derived (slug+index) → immutable.
        Cache-Control "public, max-age=31536000, immutable"
        -Server
    }

    log {
        output file /var/log/caddy/media.log
        format json
    }

    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    handle {
        root * /var/lib/radon/media
        file_server {
            precompressed gzip
        }
    }
}

# http://mcp.radon.run — dedicated Streamable HTTP MCP host (issue #232).
# HTTP only: an HTTPS site address makes Caddy obtain a cert during
# `systemctl reload caddy`. The still-running old process 308s HTTP-01
# for this new hostname, ACME never completes, and publish-caddy TERMs
# the reload (45s, 180s, on_demand, ask-on-self, ask-on-health). Once
# this HTTP site is live, a later HTTPS site can ACME against a process
# that already answers Host: mcp.radon.run on :80.
http://mcp.radon.run {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Same contract as app.radon.run /mcp*: keep the /mcp prefix, bound the
    # anonymous POST body, no retry loop (POST JSON-RPC has no idempotency key).
    handle /mcp* {
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:8334 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                read_timeout 300s
            }
        }
    }

    # https://mcp.radon.run (no path) is a valid connector URL. Rewrite to
    # /mcp so FastMCP's streamable_http_path still sees the prefix.
    @mcp_root path /
    handle @mcp_root {
        rewrite * /mcp
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:8334 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                read_timeout 300s
            }
        }
    }
}
