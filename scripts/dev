#!/usr/bin/env bash
# scripts/dev - laptop runs only Next.js attached to the VPS; launched by
# scripts/cloud.sh, which sets RADON_DEV_PROFILE=cloud-thin and the API /
# relay URLs. FastAPI, the IB relay and the collectors run on Hetzner.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PROFILE="${RADON_DEV_PROFILE:-cloud-thin}"

cd "$PROJECT_ROOT/web"

if [[ "$PROFILE" == "cloud-thin" ]]; then
  echo "[dev] profile=cloud-thin - laptop = Next.js only"
  echo "[dev]   RADON_API_URL=${RADON_API_URL:-(unset, defaulting to localhost)}"
  echo "[dev]   IB_REALTIME_WS_URL=${IB_REALTIME_WS_URL:-(unset, defaulting to localhost)}"
  echo "[dev]   NEXT_PUBLIC_IB_REALTIME_WS_URL=${NEXT_PUBLIC_IB_REALTIME_WS_URL:-(unset)}"
  echo "[dev]   HEADLINES_WS_URL=${HEADLINES_WS_URL:-(unset, defaulting to localhost)}"
  echo "[dev]   NEXT_PUBLIC_HEADLINES_WS_URL=${NEXT_PUBLIC_HEADLINES_WS_URL:-(unset)}"
  echo "[dev]   ALLOWED_USER_IDS must be set in web/.env or the operator routes 403"
  exec next dev
fi

echo "[dev] laptop runs only Next.js; unknown profile '$PROFILE' - use scripts/cloud.sh" >&2
exit 2
