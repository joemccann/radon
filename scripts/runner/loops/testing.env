# Read by scripts/runner/run_loop.sh. Plain shell assignments only.
# Cut over from scripts/testing_weekend.sh: same branch prefix and start time
# as the old loop.
BRANCH_PREFIX=testing
PROMPT=.claude/runner-prompts/testing.md
# Tried in order; the next one runs only when an agent exits non-zero
# (never after a timeout, so one night is bounded by TIMEOUT_SECS).
AGENTS="grok codex agy fx:nvidia fx:cerebras"
# 4h, above the usual 3h: the closing gate is three serial rounds of the full
# pytest, vitest and cloud suites on this host, before the CI watch.
TIMEOUT_SECS=14400
# LaunchDaemon start time (local), used by install.sh.
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=10
