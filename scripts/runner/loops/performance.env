BRANCH_PREFIX=performance
PROMPT=.claude/runner-prompts/performance.md
AGENTS="grok codex agy fx:nvidia fx:cerebras"
# One phase so the header carries `State:`, where the pre-run hook leaves
# prod-probe.json copied from the separate helper account.
PHASES="perf:14400"
PRE_RUN=hooks/performance_pre.sh
# Installer copies this target into root-owned helper configuration. Only the
# separate snapshot uid holds the forced-command key (docs/runner.md 8c).
PERF_SSH_TARGET=radon@100.112.32.16
# 22:00 Pacific = 01:00 ET: markets closed, ahead of the 00:00 loop wave.
SCHEDULE_HOUR=22
SCHEDULE_MINUTE=0
DEADMAN_LABEL=performance-nightly
DEADMAN_TITLE="Nightly performance runner"
