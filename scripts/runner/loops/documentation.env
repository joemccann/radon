# Read by scripts/runner/run_loop.sh. Plain shell assignments only.
# Shadow run next to scripts/documentation_nightly.sh: its own branch prefix
# so the two never push to the same branch. Rename to "documentation" at cutover.
BRANCH_PREFIX=documentation-runner
PROMPT=.claude/runner-prompts/documentation.md
# Tried in order; the next one runs only when an agent exits non-zero
# (never after a timeout, so one night is bounded by TIMEOUT_SECS).
AGENTS="grok codex agy fx:nvidia fx:cerebras"
TIMEOUT_SECS=10800
# LaunchDaemon start time (local), used by install.sh.
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=0
