# Read by scripts/runner/run_loop.sh. Plain shell assignments only.
# Cut over from scripts/security_nightly.sh: same branch prefix, start time, caps and dead-man label.
BRANCH_PREFIX=security
PROMPT=.claude/runner-prompts/security.md
# Claude only. Rungs come from the skip-newest resolver; the AGENTS line below is its safety fallback (never fable).
ALLOWED_AGENTS=claude
AGENTS_RESOLVER=lib/security_claude_ladder.py
AGENTS="claude:claude-opus-5 claude:claude-sonnet-5"
# The old per-phase wall-clock caps: audit 2h, remediate 6h, deliver 3h.
PHASES="audit:7200 remediate:21600 deliver:10800"
GH_GUARD=1
PRE_RUN=hooks/security_pre.sh
POST_RUN=hooks/security_post.sh
# Vitest stage: both bun trees survive the nightly re-clone; security_pre.sh
# installs them (frozen, no scripts) only when a lockfile changes.
KEEP_PATHS="node_modules web/node_modules"
AGENT_ENV="RADON_LADDER_NO_AUTH_FILES=1 RADON_WEEKEND_BROWSER_HOST=unavailable:disabled"
# 29 BILLING_REROUTE_KEYS + 8 BILLING_REROUTE_FLAGS copied verbatim from security_nightly.sh:1584-1585, plus the browser and codex reroutes.
AGENT_UNSET="PW_TEST_CONNECT_WS_ENDPOINT OPENAI_API_KEY CODEX_API_KEY ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_API_KEY CLAUDE_CODE_API_BASE_URL CLAUDE_CODE_HFI_BEARER_TOKEN CLAUDE_API_KEY CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR AWS_BEARER_TOKEN_BEDROCK ANTHROPIC_AWS_API_KEY ANTHROPIC_AWS_BASE_URL ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_BEDROCK_MANTLE_BASE_URL ANTHROPIC_VERTEX_BASE_URL ANTHROPIC_GOOGLE_CLOUD_BASE_URL ANTHROPIC_FOUNDRY_API_KEY ANTHROPIC_FOUNDRY_AUTH_TOKEN ANTHROPIC_FOUNDRY_BASE_URL ANTHROPIC_FOUNDRY_RESOURCE ANTHROPIC_IDENTITY_TOKEN ANTHROPIC_IDENTITY_TOKEN_FILE CLAUDE_CODE_GATEWAY_TOKEN CLAUDE_CODE_GATEWAY_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_HOST_AUTH_ENV_VAR CLAUDE_CODE_HOST_CREDS_FILE ANTHROPIC_UNIX_SOCKET ANTHROPIC_PROFILE ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_ORGANIZATION_ID CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_USE_GATEWAY CLAUDE_CODE_USE_MANTLE CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST"
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=40
