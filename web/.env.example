# web/.env — loaded by Next.js (web/ workspace). Copy to web/.env and
# fill in values before `npm run dev` / build.
#
#   cp web/.env.example web/.env
#
# The root .env is loaded by python-dotenv for FastAPI / scripts; this
# file is loaded by Next.js. Some vars are repeated across both because
# Next.js can't read the root file from inside web/.

# =============================================================================
# AI / LLM providers (required)
# =============================================================================
# xAI Grok — CMD+J assistant and newsfeed voice (preferred when a Grok grant is set).
# SUBSCRIPTIONS ONLY (2026-09-18): the grok CLI's ~/.grok/auth.json OIDC grant
# (or XAI_OAUTH_TOKEN / GROK_OAUTH_TOKEN) is the meter. A prepaid XAI_API_KEY /
# GROK_API_KEY is read ONLY under RADON_LADDER_ALLOW_PREPAID=1, never as a
# fallback. GROK_AUTH_FILE overrides the file path. Optional: LLM_PROVIDER=xai|grok.
# XAI_OAUTH_TOKEN=
# GROK_AUTH_FILE=~/.grok/auth.json
# XAI_API_KEY=            # prepaid; ignored unless RADON_LADDER_ALLOW_PREPAID=1
# XAI_MODEL=grok-4.6
# XAI_BASE_URL=https://api.x.ai/v1
# OpenAI — ChatGPT subscription via the codex CLI's ~/.codex/auth.json grant
# (or CODEX_OAUTH_TOKEN + CODEX_ACCOUNT_ID); calls go to chatgpt.com's codex
# Responses endpoint, text only. A provider only appears in the chat model
# picker when its grant is present. Prepaid OPENAI_API_KEY is read ONLY under
# RADON_LADDER_ALLOW_PREPAID=1.
# CODEX_OAUTH_TOKEN=
# CODEX_ACCOUNT_ID=
# OPENAI_API_KEY=         # prepaid; ignored unless RADON_LADDER_ALLOW_PREPAID=1
# OPENAI_MODEL=gpt-5.5
# LLM_PROVIDER=xai
# LLM_FALLBACK_PROVIDER=anthropic   # default when xAI is auto-preferred and an Anthropic grant exists

# Anthropic — Claude Max subscription via Claude Code's ~/.claude/.credentials.json
# (or CLAUDE_CODE_OAUTH_TOKEN; CLAUDE_CONFIG_DIR overrides the directory): share-card
# OG renders, vision tagger, seasonality vision fallback, assistant fallback.
# Prepaid ANTHROPIC_API_KEY / CLAUDE_CODE_API_KEY / CLAUDE_API_KEY are read ONLY
# under RADON_LADDER_ALLOW_PREPAID=1, never as a fallback (2026-09-18).
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=      # prepaid; ignored unless RADON_LADDER_ALLOW_PREPAID=1
# RADON_LADDER_ALLOW_PREPAID=0
# Optional model / endpoint overrides.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Cerebras inference — last rung of the shared model ladder (text tagger + distill).
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Unusual Whales (required for scanner / discover / flow / dark-pool routes)
# =============================================================================
UW_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Exa search (optional — get key at https://dashboard.exa.ai/api-keys)
# =============================================================================
EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Clerk authentication (required in production; bypassed in dev / Playwright)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# First-run setup wizard (/setup): active only while BOTH Clerk keys above
# are empty AND the completion latch is not set. Fixed token for automation;
# default is a one-shot token printed to the console that launched Radon.
# docs/operations.md "First-run setup".
# RADON_SETUP_TOKEN=
# Completion latch. Set to 1 by the wizard (mirrored from the gitignored
# marker .radon/setup-complete at every Node boot); with it set and no Clerk
# keys loaded the app answers 503 AUTH_MISCONFIGURED until restarted.
# RADON_SETUP_COMPLETE=

# =============================================================================
# Backend wiring (required)
# =============================================================================
# WS relay (`ib_realtime_server.js`) URL exposed to the browser.
IB_REALTIME_WS_URL=ws://localhost:8765
NEXT_PUBLIC_IB_REALTIME_WS_URL=ws://localhost:8765
# Internal FastAPI base. Localhost values get the auth bypass.
RADON_API_URL=http://localhost:8321
NEXT_PUBLIC_RADON_API_URL=http://localhost:8321
