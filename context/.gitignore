# Scratchpads are ephemeral
pad/

# Transaction logs can get large
history/_transactions.jsonl

# SQLite databases (if used as backend)
*.sqlite3
*.sqlite3-journal

# Live account state and agent-memory facts. The constructor writes these
# locally. The GitHub repo is public, so only the source-of-truth rule
# (no account figures) stays tracked.
# Guarded by tests/test_no_tracked_account_figures.py.
memory/fact/*.json
!memory/fact/portfolio-source-of-truth.json
