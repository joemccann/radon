# Ticker/market data caches (regenerated at runtime)
data/ticker_cache.json
data/company_info_cache/
data/cri_scheduled/
data/menthorq_cache/
data/menthorq_dashboard/
data/seasonality_cache/
data/darkpool_cache/
data/uw_http_cache/
data/price_history_cache/
data/rv_ratio/
data/service_health/
# Incident watchdog artifacts (scripts/incident_watchdog) — runtime-owned
data/incidents/
# Laptop mirror of VPS incidents + responder state/diagnoses
data/incidents_remote/
# Red proposal tests parked by /incident analyze-only runs (never in the
# live test tree, never in the rsync mirror — both delete them)
data/incident_proposals/
# Nightly Turso dump pulls (DUR-13, rsync'd from the VPS — never commit)
data/db_backups/
# Runtime-owned by the preset_rebalance handler on the VPS; tracking these
# trips deploy.sh's tracked-drift guard on every rebalance (untracked
# 2026-07-20 after changelog.json, then r2k-*.json, blocked deploys — same
# class as tag_taxonomy.json 2026-07-15). VPS copies are authoritative.
data/presets/
# Daily journald snapshots pulled from the VPS (DUR-12, laptop launchd job)
data/journal_archive/
# host_metrics sampler's capped local fallback when Turso writes fail (DUR-12)
data/host_metrics_fallback.jsonl
logs/*
!logs/.gitkeep
logs/menthorq_artifacts/
web/data/

# IB Gateway mode toggle (per-developer state, written by scripts/ib)
.env.ib-mode

# Newsfeed scraper runtime artifacts (regenerated each cycle)
web/public/data/
web/public/media/

# Newsfeed Playwright storage state (cookies + localStorage; re-derived per machine)
data/newsfeed-storage*.json
data/newsfeed-debug-*.png

# DeepSec's own workspace (separate tool, ~850MB with its own node_modules
# and .env.local). Nothing under it is Radon source.
.deepsec/

# Grok workflow scripts. One-shot prompts named after the task that spawned
# them (implement-stop-orders, cut-uw-daily-quota, ...), each written once and
# never re-run. Nothing in the repo reads this directory — no unit, timer, CI
# job, or script — so committing them only accumulated a graveyard that looked
# like live automation. Keep them locally; version one only if it becomes
# something that actually gets re-run.
.grok/

# Temp files
tmp/
/nanobanana-output/
/.playwright-mcp/
/regime-*.png

# Runtime caches
data/cache/
data/locks/
data/nav_history.jsonl

# Watchdog alert-suppression state (scripts/watchdog/state_db.py). Host-local
# ON PURPOSE — keeping cooldowns in Turso would let a data-plane outage
# disable the component that reports it. `data/*.json` already covers the
# sibling JSON state; the SQLite store and its WAL sidecars were not covered,
# leaving one host's suppression one `git add` away from muting every host.
data/watchdog_state.db
data/watchdog_state.db-wal
data/watchdog_state.db-shm

# Per-run lock sidecars next to the JSON state they guard.
data/*.json.lock

# setup-grok-page-responder.sh drops this in the dedicated VPS clone. Untracked
# it reads as dirty work, and sync_remote_clone then refuses to fast-forward —
# pinning the responder to whatever grok last committed.
/.radon-page-responder

# Verification screenshots (generated during UI work)
/internals-panel.png
web/internals-panel.png
web/regime-panel.png

# One-time verification scripts
web/verify-regime-internals.mjs

# Local agent worktrees / scratch state
/.claude/worktrees/
/.claude/hooks/dead-code.manifest

# Local skill / agent installations (per-developer, not checked in).
# The starred form (not a bare dir) lets repo-owned skills below re-include.
/.agents/
/.claude/skills/*
!/.claude/skills/incident-response/
!/.claude/skills/long-horizon-jobs/
!/.claude/skills/reliability-weekend/
!/.claude/skills/testing-weekend/
/.pi/skills/
/skills-lock.json
/radon-dark-full.png

