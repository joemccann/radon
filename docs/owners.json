{
  "rules": [
    {
      "id": "indicators",
      "globs": ["docs/indicators/*.md"],
      "owners": ["docs/indicators/README.md"],
      "note": "Every spec needs an index row. README.md itself is the owner."
    },
    {
      "id": "equibles",
      "globs": [
        "cloud/services/radon-equibles-*",
        "scripts/fetch_equibles_*.py"
      ],
      "owners": ["docs/equibles-api.md", "docs/operations.md"]
    },
    {
      "id": "incidents",
      "globs": [
        "scripts/incident_watchdog/**",
        "scripts/incident_responder.py",
        "scripts/grok_page_responder.py",
        "scripts/watchdog/pages.py",
        "scripts/deploy_notify.py",
        "config/com.radon.grok-page-responder.plist",
        "cloud/scripts/nextjs_db_watchdog.py",
        "cloud/services/radon-incident-watchdog.*",
        "cloud/services/radon-nextjs-db-watchdog.*"
      ],
      "owners": ["docs/incident-runbook.md", "docs/grok-page-responder.md"]
    },
    {
      "id": "host-split",
      "globs": [
        "scripts/ib_gateway_remote/**",
        "cloud/services/radon-ib-gateway-remote.service",
        "cloud/scripts/ib-gateway-remote-certs.sh",
        "cloud/scripts/check-env.py"
      ],
      "owners": ["docs/spof-host-split.md"],
      "note": "App/broker split contract: mTLS Gateway control, cert lifecycle, role env checks. Recurring runbook drift class (DOC-002/006/009/010/017/018/019)."
    },
    {
      "id": "api-trust-boundary",
      "globs": ["scripts/api/auth.py"],
      "owners": ["scripts/api/CLAUDE.md", "docs/spof-host-split.md"],
      "note": "Who FastAPI trusts without a JWT (loopback, tailnet, the private-net /health probe). Both owners restated the 10.0.0.0/16 scope wrongly after REL-170 (DOC-020/022)."
    },
    {
      "id": "ops-timers",
      "globs": ["cloud/services/*.timer"],
      "owners": ["docs/operations.md", "docs/cloud-services.md"]
    },
    {
      "id": "nightly-loops",
      "globs": [
        "scripts/*_weekend.sh",
        "scripts/*_nightly.sh",
        "scripts/weekend_notify.py",
        "scripts/weekend_redact.py",
        "config/com.radon.*-daily.plist"
      ],
      "owners": ["docs/operations.md"],
      "note": "operations.md is the one place indexing all five nightly loops: fire times, clone + marker rails, the model pin and the status vocabulary an operator reads off a page. #219 changed operator-facing behaviour in all five wrappers with no owner update (DOC-032/033/034/040). Loop SEMANTICS stay in .claude/skills/<loop>/SKILL.md; only the operator contract belongs here."
    },
    {
      "id": "factory",
      "globs": ["scripts/factory_sandbox_setup.sh"],
      "owners": ["docs/factory.md"],
      "note": "Sandbox setup that runs inside the radon checkout for the sibling Foreman app."
    },
    {
      "id": "cli",
      "globs": [".pi/commands.json"],
      "owners": ["docs/scripts-reference.md"]
    },
    {
      "id": "repo-front-door",
      "globs": [
        "SECURITY.md",
        "SUPPORT.md",
        "CONTRIBUTING.md",
        "docs/README.md",
        "docs/external-services.md"
      ],
      "owners": ["docs/README.md"],
      "note": "GitHub front door. Root README.md is pinned by TestThinIndex, not this glob: a bare README.md glob matches every nested README via basename."
    }
  ]
}
