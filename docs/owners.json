{
  "rules": [
    {
      "id": "indicators",
      "globs": ["docs/indicators/*.md"],
      "owners": ["docs/indicators/README.md"],
      "note": "Every spec needs an index row. README.md itself is the owner."
    },
    {
      "id": "equibles",
      "globs": [
        "cloud/services/radon-equibles-*",
        "scripts/fetch_equibles_*.py"
      ],
      "owners": ["docs/equibles-api.md", "docs/operations.md"]
    },
    {
      "id": "incidents",
      "globs": [
        "scripts/incident_watchdog/**",
        "scripts/incident_responder.py",
        "scripts/grok_page_responder.py",
        "scripts/watchdog/pages.py",
        "scripts/deploy_notify.py",
        "config/com.radon.grok-page-responder.plist",
        "cloud/scripts/nextjs_db_watchdog.py",
        "cloud/services/radon-incident-watchdog.*",
        "cloud/services/radon-nextjs-db-watchdog.*"
      ],
      "owners": ["docs/incident-runbook.md", "docs/grok-page-responder.md"]
    },
    {
      "id": "ops-timers",
      "globs": ["cloud/services/*.timer"],
      "owners": ["docs/operations.md", "docs/cloud-services.md"]
    },
    {
      "id": "factory",
      "globs": ["scripts/factory_sandbox_setup.sh"],
      "owners": ["docs/factory.md"],
      "note": "Sandbox setup that runs inside the radon checkout for the sibling Foreman app."
    },
    {
      "id": "cli",
      "globs": [".pi/commands.json"],
      "owners": ["docs/scripts-reference.md"]
    },
    {
      "id": "repo-front-door",
      "globs": [
        "SECURITY.md",
        "SUPPORT.md",
        "CONTRIBUTING.md",
        "docs/README.md",
        "docs/external-services.md"
      ],
      "owners": ["docs/README.md"],
      "note": "GitHub front door. Root README.md is pinned by TestThinIndex, not this glob: a bare README.md glob matches every nested README via basename."
    }
  ]
}
