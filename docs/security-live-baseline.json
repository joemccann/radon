{
  "version": 1,
  "description": "Expected live security posture for scripts/security_live_drift.py. A read-only weekly check (no model calls) compares this file, cloud/tailscale/policy.hujson and the app host's trust mode with what is live. Sources: CLAUDE.md Pull Request Completion (strict, 28 app-bound required checks, enforce_admins); docs/runner.md Safety boundary and steps 8b.5 and 11 (main-review ruleset; one radon-runner-bot write deploy key on the reports repo, the old wrapper key retired); docs/security-deepsec-closed.json DS-2026-09-23-02 (rulesets 24143098 and 24587201); docs/operations.md Tailnet trust narrowing (enforce closes the unlisted-peer bypass). The reports-repo protection and secret-scanning entries were seeded from the live API on 2026-10-31 because no doc states them. Change this file in the same PR as the live change it records.",
  "tailnet_policy": {
    "path": "cloud/tailscale/policy.hujson",
    "placeholder": "__OPERATOR_LOGIN__",
    "placeholder_group": "group:operator"
  },
  "tailnet_trust": {
    "service": "radon-api.service",
    "env_file": "/etc/radon/env",
    "expected_mode": "enforce"
  },
  "github": {
