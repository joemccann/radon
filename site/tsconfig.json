{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-dev-webpack/types/**/*.ts",
    ".next-dev-webpack/dev/types/**/*.ts",
    ".next-seo-audit/types/**/*.ts",
    ".next-seo-audit/dev/types/**/*.ts",
    ".next-tester-army/types/**/*.ts",
    ".next-tester-army/dev/types/**/*.ts",
    ".next-site-playwright/types/**/*.ts",
    ".next-site-playwright/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tester-army"
  ]
}
