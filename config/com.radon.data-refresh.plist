<?xml version="1.0" encoding="UTF-8"?>
<!-- Must stay unloaded while VPS owns signals or laptop scanner+discover will double UW burn. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.radon.data-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/joemccann/dev/apps/finance/radon/scripts/run_data_refresh.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/joemccann/dev/apps/finance/radon</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>900</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Users/joemccann/dev/apps/finance/radon/logs/data-refresh.out.log</string>
  <key>StandardErrorPath</key><string>/Users/joemccann/dev/apps/finance/radon/logs/data-refresh.err.log</string>
</dict>
</plist>
