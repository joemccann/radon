# Vercel Connect GitHub connector UID. The deploy flow sets this.
GITHUB_CONNECTOR=github/foreman-agent

# The repository the factory works on. Required at build time.
FACTORY_REPO=joemccann/radon

# Runs inside the radon checkout once per sandbox template build.
# Git, bun, and pip only. Never sources env files.
FACTORY_SETUP_COMMAND=bash scripts/factory_sandbox_setup.sh

# Optional overrides.
# FACTORY_LABEL=factory
# FACTORY_BRANCH_PREFIX=factory/
# FACTORY_BOT_NAME=
